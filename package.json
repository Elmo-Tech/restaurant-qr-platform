{
  "name": "restaurant-qr-platform",
  "version": "1.0.0",
  "description": "Multi-tenant QR ordering platform for restaurants and cafes",
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:api": "npm run lint --workspace=apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "test": "npm run test --workspaces --if-present",
    "db:validate": "npm run prisma:validate --workspace=apps/api",
    "db:generate": "npm run prisma:generate --workspace=apps/api"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1"
}
