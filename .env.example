# Restaurant QR Platform - Environment Example
#
# Copy this file to `.env` for local development when application scaffolding
# is ready.
#
# IMPORTANT:
# - Never commit real secrets.
# - Values in this file are examples only.
# - Production secrets must be supplied through secure server / deployment
#   configuration.
# - Anything prefixed with NEXT_PUBLIC_ is visible to the browser.
# - n8n / AI provider credentials should remain server-side.
#
# Architecture principle:
# Simple architecture. Premium product.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

NODE_ENV=development

# Expected values during implementation:
# development | test | staging | production
APP_ENV=development

# -----------------------------------------------------------------------------
# Public application URLs
# -----------------------------------------------------------------------------

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Stable public application origin.
# In Production this becomes the HTTPS domain used by Guest-facing links and QR
# flows.
PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------

# Public browser configuration only. Never place secrets in NEXT_PUBLIC_*.
#
# Batch G (Staff Web foundation): the Staff browser calls the API directly
# (Backend CORS_ORIGIN + credentials already support this), so it needs the
# API's absolute origin in addition to the existing base path.
#
# NEXT_PUBLIC_API_URL is REQUIRED -- apps/web/src/lib/api/config.ts throws at
# startup if it is unset or empty. There is no supported "leave it empty"
# mode; it always combines with NEXT_PUBLIC_API_BASE_PATH to form the full
# API base URL.
#
# In dev, Web (3000) and API (4000) are different origins, so this points at
# the API's own absolute origin+port, as below.
#
# V1 Production requirement: the Staff session cookie is host-only (no
# `domain` attribute -- AUTH_TENANCY_SPEC.md), and the SSR session bootstrap
# (apps/web/src/lib/api/server-fetch.ts) forwards the incoming Web request's
# `Cookie` header to the API server-to-server. For that forwarded cookie to
# ever match the one the browser actually holds, Staff Web and the Staff API
# must be served from the SAME HOSTNAME in Production, e.g.:
#   NEXT_PUBLIC_API_URL=https://app.example.com
#   NEXT_PUBLIC_API_BASE_PATH=/api/v1
# with a reverse proxy routing the /api path to the NestJS API on that same
# hostname (consistent with this file's existing "Production is designed to
# be same-origin through Nginx" CORS_ORIGIN comment, below). The actual
# Nginx/reverse-proxy configuration is a separate, later batch -- this is
# documentation only.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_REALTIME_PATH=/socket.io

# Optional server-only origin for Next.js Server Components. Leave unset in
# native local development so SSR uses NEXT_PUBLIC_API_URL. In Docker Compose
# production this is `http://api:4000`, keeping server-side calls on the private
# network. Never prefix it with NEXT_PUBLIC_.
# API_INTERNAL_URL=http://api:4000

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1

# Production is designed to be same-origin through Nginx.
CORS_ORIGIN=http://localhost:3000

# Platform control dashboard (DEC-045): the platform team's web app (apps/platform). Its origin is a second
# trusted CORS origin and the ONLY origin accepted on /api/v1/platform/* routes. Leave empty to disable
# the platform API entirely. Never a wildcard.
PLATFORM_ORIGIN=http://localhost:3001
# Platform Administrator session: own cookie name (never the restaurant dashboard cookie) and lifetime in hours.
PLATFORM_SESSION_COOKIE_NAME=platform_session
PLATFORM_SESSION_TTL_HOURS=12
# Subscriptions (DEC-049): days after a subscription ends before the Restaurant is suspended automatically.
SUBSCRIPTION_GRACE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma
# -----------------------------------------------------------------------------

POSTGRES_DB=restaurant_qr_platform
POSTGRES_USER=restaurant_qr
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Native Windows API -> Docker PostgreSQL local connection.
DATABASE_URL=postgresql://restaurant_qr:change-me-local-only@localhost:5432/restaurant_qr_platform?schema=public

# Optional Prisma development shadow database.
# Enable only if the chosen migration workflow requires an explicit one.
# SHADOW_DATABASE_URL=postgresql://restaurant_qr:change-me-local-only@localhost:5432/restaurant_qr_platform_shadow?schema=public

# -----------------------------------------------------------------------------
# Staff authentication
# -----------------------------------------------------------------------------

# Staff authentication uses opaque DB-backed sessions, not JWT refresh tokens.
AUTH_SESSION_COOKIE_NAME=restaurant_session

# Approved V1 guidance: approximately 30-day absolute staff-session expiry.
AUTH_SESSION_TTL_DAYS=30

# Secure cookies may be false only for plain-http localhost development.
# Production must use secure cookies behind HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Approved V1 guidance: password-reset token lifetime is approximately 30-60
# minutes. 45 minutes is the initial configurable implementation default.
PASSWORD_RESET_TTL_MINUTES=45

# Approved V1 guidance: Restaurant invitations expire after approximately 7 days.
RESTAURANT_INVITATION_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Guest session
# -----------------------------------------------------------------------------

GUEST_SESSION_COOKIE_NAME=restaurant_guest

# Approved V1 guidance: Guest Session lifetime is bounded to approximately 24h.
GUEST_SESSION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------

# Argon2id parameters must be benchmarked on the deployment server before
# Production values are finalized.
#
# Do not invent or weaken these values merely to make tests faster.
# ARGON2_MEMORY_COST=
# ARGON2_TIME_COST=
# ARGON2_PARALLELISM=

# -----------------------------------------------------------------------------
# Uploads / media
# -----------------------------------------------------------------------------

# V1 starts with a server-backed storage abstraction.
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_DIR=./storage/uploads

# The exact upload-size limit has not been approved yet.
# Define and validate it during the upload implementation instead of treating an
# arbitrary value in this example file as Product policy.
# UPLOAD_MAX_BYTES=

# Backend must also validate file signatures and allow only approved image types.
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# Realtime
# -----------------------------------------------------------------------------

# V1 runs one API instance, so Redis is intentionally not configured.
# Add Redis only when a proven shared-state / multi-instance requirement exists.
REALTIME_ENABLED=true

# -----------------------------------------------------------------------------
# AI Assistant
# -----------------------------------------------------------------------------

# Backend-enforced global AI kill switch.
AI_ENABLED=true

# Guest AI remains Beta and read-only in V1.
AI_GUEST_ENABLED=true

# AI request timeout must be bounded, but the exact value should be selected and
# tuned during implementation / Pilot measurement.
# AI_REQUEST_TIMEOUT_MS=

# Approved V1 recommendation: approximately 5 Backend AI Tool calls per Guest
# turn. Keep it configurable because Pilot data may justify tuning it.
AI_MAX_TOOL_CALLS_PER_TURN=5

# Guest message length must be bounded before model invocation, but no exact
# Product limit has been approved yet.
# AI_MAX_MESSAGE_CHARACTERS=

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------

# Local n8n editor / service.
N8N_URL=http://localhost:5678

# Backend -> n8n private orchestration endpoint.
# Replace the path if the implemented workflow uses another internal webhook.
# This is never the normal public Guest AI endpoint.
N8N_AI_WEBHOOK_URL=http://localhost:5678/webhook/guest-ai-assistant-v1

# Dedicated Backend -> n8n service secret.
N8N_BACKEND_WEBHOOK_SECRET=replace-with-random-secret

# Dedicated n8n -> Backend AI Tool service secret.
# Never reuse Guest or Staff credentials.
N8N_BACKEND_TOOL_SECRET=replace-with-random-secret

# Menu Import (DEC-040): private n8n webhook that extracts a Draft from an uploaded menu file.
# Leave commented out to disable the import (the API then answers 503 AI_UNAVAILABLE).
# N8N_MENU_IMPORT_URL=http://localhost:5678/webhook/menu-extract-v1
# N8N_MENU_IMPORT_SECRET=replace-with-random-secret
# MENU_IMPORT_TIMEOUT_SECONDS=300

# Model API keys saved from the Platform console (DEC-059) are stored encrypted with this key:
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set it once and never change it (a different key cannot read the keys already saved).
# Optional: without it the console cannot save keys and Menu Import keeps using n8n.
# AI_KEYS_ENCRYPTION_KEY=
# Optional, for tests and local experiments only: the chat endpoint the direct engine calls instead of Gemini's.
# AI_CHAT_COMPLETIONS_URL=http://127.0.0.1:9999/chat

# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------

# Model-provider credentials should normally live in n8n Credentials or secure
# n8n environment configuration.
#
# Keep provider choice replaceable. The Product contract is provider-independent.
#
# Example only:
# OPENAI_API_KEY=
#
# Never add NEXT_PUBLIC_OPENAI_API_KEY or any equivalent browser-exposed secret.

# -----------------------------------------------------------------------------
# AI prompt / orchestration versioning
# -----------------------------------------------------------------------------

AI_PROMPT_VERSION=guest-ai-system-v1.0
AI_WORKFLOW_VERSION=guest-ai-assistant-v1

# -----------------------------------------------------------------------------
# AI conversation / retention
# -----------------------------------------------------------------------------

# Conversation history sent to the model must be bounded, but the exact turn /
# token budget has not been approved yet.
# AI_MAX_HISTORY_TURNS=

# Do not define a retention period here until the Backend conversation
# persistence and Privacy policy are explicitly designed and approved.
# AI_CONVERSATION_RETENTION_DAYS=

# -----------------------------------------------------------------------------
# Logging / observability
# -----------------------------------------------------------------------------

LOG_LEVEL=debug

# Request / correlation IDs should be generated by the application.
# Never place authentication tokens or secrets into normal logs.

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Application-level rate limiting (in-memory, per API process, keyed by client
# IP). The reverse proxy (Nginx) adds its own limits at deployment. Defaults are
# chosen so a restaurant's shared Wi-Fi is not blocked.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Every route, per IP per window:
RATE_LIMIT_DEFAULT_LIMIT=300
# Staff login / accept-invitation attempts, per IP per window:
RATE_LIMIT_LOGIN_LIMIT=10
# Public Guest order creation, per IP per window:
RATE_LIMIT_PUBLIC_ORDER_LIMIT=30

# Guest order tracking: status polling, and the "find my order by phone" lookup (strict).
RATE_LIMIT_PUBLIC_TRACKING_LIMIT=120
RATE_LIMIT_PUBLIC_LOOKUP_LIMIT=10

# Number of reverse-proxy hops to trust for the client IP (X-Forwarded-For).
# 0 = direct connection (local dev). Set 1 behind Nginx, otherwise every client
# shares the proxy IP for rate limiting.
TRUST_PROXY_HOPS=0

# AI endpoint rate limiting is required, but exact limits must be selected from
# implementation / Pilot measurements rather than fixed here prematurely.
# AI_RATE_LIMIT_WINDOW_SECONDS=
# AI_RATE_LIMIT_MAX_REQUESTS=

# -----------------------------------------------------------------------------
# Docker / infrastructure
# -----------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=restaurant-qr-platform

# Production domain is configured during deployment.
# Example:
# APP_DOMAIN=menu.example.com

# -----------------------------------------------------------------------------
# Production notes
# -----------------------------------------------------------------------------
#
# Production should:
#
# - Use HTTPS.
# - Set AUTH_COOKIE_SECURE=true.
# - Use strong unique Database credentials.
# - Keep PostgreSQL private.
# - Keep n8n management access protected.
# - Keep all AI / n8n secrets server-side.
# - Use the stable public application domain for printed QR codes.
# - Run Prisma migrations with `prisma migrate deploy`.
# - Never use `prisma db push`.
# - Back up PostgreSQL before risky migrations.
# - Use separate Development / Staging / Production credentials.
#
# Do not add Redis, queues, extra workers, or additional infrastructure until
# real workload demonstrates the need.
