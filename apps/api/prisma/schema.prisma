datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// -----------------------------------------------------------------------------
// Enums (DATABASE_SPEC.md #138, AUTH_TENANCY_SPEC.md #16 / #39 / #45)
// -----------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("restaurant_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum UserState {
  ACTIVE
  INVITED
  DISABLED

  @@map("user_state")
}

// FT-12C: the immutable KIND of a Restaurant Role (`RestaurantRole.kind`),
// copied onto each Membership at assignment. OWNER marks the protected system
// Role; MANAGER/CASHIER/KITCHEN/WAITER mark the starter Roles seeded for every
// Restaurant; CUSTOM marks a Restaurant-defined Role. It is a label only --
// the Permissions a Membership holds always come from its `restaurantRole`.
enum RestaurantMembershipRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
  CUSTOM

  @@map("restaurant_membership_role")
}

enum RestaurantMembershipStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("restaurant_membership_status")
}

enum TableStatus {
  ACTIVE
  INACTIVE

  @@map("table_status")
}

enum QrType {
  TABLE
  GENERIC

  @@map("qr_type")
}

enum QrStatus {
  ACTIVE
  INACTIVE

  @@map("qr_status")
}

enum MenuStatus {
  ACTIVE
  INACTIVE

  @@map("menu_status")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE

  @@map("product_variant_status")
}

enum ProductAvailability {
  AVAILABLE
  SOLD_OUT

  @@map("product_availability")
}

// Product Discounts V1 (PROMOTIONS_SPEC.md #3): the only two discount types.
enum ProductDiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("product_discount_type")
}

// FT-5: matches ORDER_LIFECYCLE_SPEC.md #16 and the already-established
// `orders.accept`/`orders.reject`/`orders.cancel`/`orders.markServed`/
// `kitchen.update` Permission constants exactly -- these values are the
// documented V1 contract, not a Fast Track invention.
enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  // FT-8: DELIVERY Orders only (READY -> OUT_FOR_DELIVERY -> SERVED); DINE_IN
  // and PICKUP never use it -- enforced by the type-aware transition rules in
  // `order-transitions.ts`, not by the database.
  OUT_FOR_DELIVERY
  SERVED
  REJECTED
  CANCELLED

  @@map("order_status")
}

// FT-7/FT-8: the explicit Order fulfillment concept: DINE_IN (TABLE QR), PICKUP
// and DELIVERY (both GENERIC QR).
enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY

  @@map("order_type")
}

enum DeliveryZoneStatus {
  ACTIVE
  INACTIVE

  @@map("delivery_zone_status")
}

// Platform control dashboard (DEC-045): the platform team's own accounts.
enum PlatformAdminStatus {
  ACTIVE
  DISABLED

  @@map("platform_admin_status")
}

// A package can be assigned to new Restaurants only while ACTIVE (DEC-046).
enum PackageStatus {
  ACTIVE
  ARCHIVED

  @@map("package_status")
}

// What the platform may allow a Restaurant to use (DEC-043). A Restaurant without a row has every feature.
enum FeatureKey {
  WHATSAPP_ORDERING
  ORDER_TRACKING
  SMART_SUGGESTIONS
  MENU_TEMPLATES
  DASHBOARD_ORDERING
  TABLE_ORDERING
  KITCHEN
  MENU_IMPORT

  @@map("feature_key")
}

// Smart suggestions in the Guest cart (DEC-042): which sources the Restaurant uses.
enum SuggestionsMode {
  OFF
  MANUAL
  AUTO
  BOTH

  @@map("suggestions_mode")
}

// How the Guest menu is laid out (DEC-044). Presentation only.
enum MenuTemplate {
  CLASSIC
  LIST
  GALLERY
  MENU
  FLOATING
  CENTERED
  COMPACT
  EDITORIAL
  EMBER
  BLOOM
  BREW

  @@map("menu_template")
}

// Table Sessions (Slice 1; TABLE_SESSION_CLOSURE_AND_PAYMENT_DESIGN.md v3).
// The session lifecycle is deliberately only OPEN | CLOSED: payment status is a
// separate, DERIVED concept (never stored here) and table QR ordering
// availability lives on `Table.staffOpenRequired`.
enum TableSessionStatus {
  OPEN
  CLOSED

  @@map("table_session_status")
}

enum TableSessionOpenedVia {
  FIRST_ORDER
  STAFF

  @@map("table_session_opened_via")
}

enum TableSessionClosureReason {
  NORMAL
  FIRST_ORDER_REJECTED
  STAFF_CORRECTION
  OTHER

  @@map("table_session_closure_reason")
}

// Only PAYMENT is created in V1; REFUND / ADJUSTMENT stay reserved (decision P9).
enum TableSessionLedgerKind {
  PAYMENT

  @@map("table_session_ledger_kind")
}

// Recorded manually by staff; the platform processes nothing (decision D10).
enum TableSessionPaymentMethod {
  CASH
  CARD
  OTHER

  @@map("table_session_payment_method")
}

enum TableSessionEventType {
  SESSION_OPENED
  SESSION_CLOSED
  PAYMENT_RECORDED
  PAYMENT_VOIDED
  BILL_PRINTED

  @@map("table_session_event_type")
}

enum TableSessionActorType {
  GUEST
  STAFF
  SYSTEM

  @@map("table_session_actor_type")
}

// -----------------------------------------------------------------------------
// Restaurant / Branch (DATABASE_SPEC.md #23-30)
// -----------------------------------------------------------------------------

model Restaurant {
  id                      String           @id @default(uuid()) @db.Uuid
  publicId                String           @unique @map("public_id")
  name                    String
  // No database default: DATABASE_SPEC.md #24 defines the allowed values but
  // not a creation default. Restaurant creation must explicitly choose the
  // initial status at the application/domain layer.
  status                  RestaurantStatus
  // Authoritative default locale (DATABASE_SPEC.md #26). restaurant_locales
  // stores supported locales only and does not maintain a second isDefault
  // flag.
  defaultLocale           String           @map("default_locale")
  currencyCode            String           @map("currency_code") @db.Char(3)
  logoAssetPath           String?          @map("logo_asset_path")
  // Guest Menu hero cover image (same media storage as logoAssetPath). Null
  // keeps the existing branded hero background.
  coverAssetPath          String?          @map("cover_asset_path")
  // Restaurant-wide switches for the two Guest order types that come in through
  // the Restaurant QR. Both default to true (nothing changes for existing
  // restaurants). Dine-in (Table QR) is never affected by them.
  pickupEnabled           Boolean          @default(true) @map("pickup_enabled")
  deliveryEnabled         Boolean          @default(true) @map("delivery_enabled")
  // Table (dine-in) channel switch (DEC-038). False = the Table QR menu is
  // view-only and TABLE QR orders are refused. Independent of the two switches
  // above and of Table Session state.
  tableOrderingEnabled    Boolean          @default(true) @map("table_ordering_enabled")
  // WhatsApp ordering (DEC-042): the Guest menu hands the priced order to WhatsApp (the
  // Restaurant's whatsappNumber) instead of creating an Order. Needs that number; off by default.
  whatsappOrderingEnabled Boolean          @default(false) @map("whatsapp_ordering_enabled")
  // Guest menu layout (DEC-044). Presentation only; CLASSIC is the original look.
  menuTemplate            MenuTemplate     @default(CLASSIC) @map("menu_template")
  // Smart suggestions in the Guest cart (DEC-042). OFF until the Restaurant turns it on.
  suggestionsMode         SuggestionsMode  @default(OFF) @map("suggestions_mode")
  // Restaurant QR appearance (applied to the Restaurant QR and the Table QR panels).
  // The defaults are today's plain black-on-white QR with the restaurant name.
  qrForegroundColor       String           @default("#000000") @map("qr_foreground_color") @db.Char(7)
  qrBackgroundColor       String           @default("#FFFFFF") @map("qr_background_color") @db.Char(7)
  qrShowLogo              Boolean          @default(false) @map("qr_show_logo")
  qrShowName              Boolean          @default(true) @map("qr_show_name")
  // Guest Menu contact details (DEC-042): one phone for the whole Restaurant, a
  // WhatsApp number (also used by WhatsApp ordering later) and public links. All
  // optional; validated and normalized by the Backend (restaurant-contact.ts).
  contactPhone            String?          @map("contact_phone")
  whatsappNumber          String?          @map("whatsapp_number")
  // Short / hotline number such as 16512 (digits only, no country code).
  hotlineNumber           String?          @map("hotline_number")
  facebookUrl             String?          @map("facebook_url")
  instagramUrl            String?          @map("instagram_url")
  tiktokUrl               String?          @map("tiktok_url")
  telegramUrl             String?          @map("telegram_url")
  youtubeUrl              String?          @map("youtube_url")
  xUrl                    String?          @map("x_url")
  snapchatUrl             String?          @map("snapchat_url")
  mapsUrl                 String?          @map("maps_url")
  websiteUrl              String?          @map("website_url")
  // The package the platform assigned (DEC-046). Null = no package: every feature (DEC-043).
  packageId               String?          @map("package_id") @db.Uuid
  // Billing (DEC-049): EG is billed in EGP, any other country in USD.
  countryCode             String           @default("EG") @map("country_code") @db.Char(2)
  // Set when the platform suspended this Restaurant because its subscription ended (DEC-049);
  // a manual status change clears it. Only a Restaurant carrying this mark is reactivated automatically.
  subscriptionSuspendedAt DateTime?        @map("subscription_suspended_at") @db.Timestamptz
  // Set when the team reactivated this Restaurant by hand: no automatic suspension for a lapse that ended before it.
  subscriptionOverrideAt  DateTime?        @map("subscription_override_at") @db.Timestamptz
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  locales               RestaurantLocale[]
  branches              Branch[]
  announcements         RestaurantAnnouncement[]
  productSuggestions    ProductSuggestion[]
  templateConfigs        RestaurantTemplateConfig[]
  features              RestaurantFeature[]
  package               Package?                 @relation(fields: [packageId], references: [id], onDelete: Restrict)
  subscriptions         Subscription[]
  subscriptionRequests  SubscriptionRequest[]
  platformAuditLog      PlatformAuditLog[]
  memberships           RestaurantMembership[]
  roles                 RestaurantRole[]
  invitations           RestaurantInvitation[]
  tables                Table[]
  qrCodes               QrCode[]
  menus                 Menu[]
  menuImportJobs        MenuImportJob[]
  categories            Category[]
  products              Product[]
  orders                Order[]
  modifierGroups        ModifierGroup[]
  modifierOptions       ModifierOption[]
  productVariants       ProductVariant[]
  modifierPresets       ModifierPreset[]
  modifierPresetOptions ModifierPresetOption[]
  deliveryZones         DeliveryZone[]

  @@index([packageId])
  @@map("restaurants")
}

// Template-specific appearance and copy: draft edits never affect public menus until published.
model RestaurantTemplateConfig {
  id                String       @id @default(uuid()) @db.Uuid
  restaurantId      String       @map("restaurant_id") @db.Uuid
  template          MenuTemplate
  draftSettings     Json         @default("{}") @map("draft_settings")
  publishedSettings Json         @default("{}") @map("published_settings")
  schemaVersion     Int          @default(1) @map("schema_version")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  restaurant        Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, template])
  @@map("restaurant_template_configs")
}

model RestaurantLocale {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  // Normalized locale string (e.g. "ar", "en"), not a fixed enum, so the
  // Platform can support additional locales without a schema change
  // (I18N_SPEC.md #2, #19).
  locale       String
  // No database default: the onboarding workflow explicitly decides whether
  // a locale is active when the record is created.
  isActive     Boolean  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, locale])
  @@map("restaurant_locales")
}

model Branch {
  id                String          @id @default(uuid()) @db.Uuid
  publicId          String          @unique @map("public_id")
  restaurantId      String          @map("restaurant_id") @db.Uuid
  name              String
  // V1 BranchStatus intentionally has no SUSPENDED value: SUSPENDED is a
  // Restaurant-level (tenant) state, and there is no documented Branch-level
  // suspended lifecycle (DATABASE_SPEC.md #27A). No database default:
  // Branch creation must explicitly choose the initial status at the
  // application/domain layer.
  status            BranchStatus
  // IANA timezone identifier (e.g. "Africa/Cairo"), not a fixed UTC offset
  // (DATABASE_SPEC.md #28).
  timezone          String
  phone             String?
  address           String?
  // Opening hours (DEC-042): ALWAYS_OPEN keeps today's behavior; SCHEDULE follows
  // BranchOpeningHour rows. `temporarilyClosed` is a manual override in both modes.
  hoursMode         BranchHoursMode @default(ALWAYS_OPEN) @map("hours_mode")
  temporarilyClosed Boolean         @default(false) @map("temporarily_closed")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  restaurant         Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  openingHours       BranchOpeningHour[]
  membershipBranches RestaurantMembershipBranch[]
  invitationBranches RestaurantInvitationBranch[]
  tables             Table[]
  qrCodes            QrCode[]
  orders             Order[]
  deliveryZones      DeliveryZone[]
  translations       BranchTranslation[]

  @@index([restaurantId])
  @@map("branches")
}

enum AnnouncementStatus {
  ACTIVE
  INACTIVE

  @@map("announcement_status")
}

enum AnnouncementStyle {
  INFO
  PROMO
  WARNING

  @@map("announcement_style")
}

/// A short message at the top of the Guest Menu (DEC-042). Dates are inclusive calendar
/// dates read in the menu's timezone (like Product discounts). At most three ACTIVE per
/// Restaurant is an application rule; the date order and text length are CHECK
/// constraints in the migration.
model RestaurantAnnouncement {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @map("restaurant_id") @db.Uuid
  status       AnnouncementStatus
  style        AnnouncementStyle
  startsOn     DateTime?          @map("starts_on") @db.Date
  endsOn       DateTime?          @map("ends_on") @db.Date
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant                          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  translations RestaurantAnnouncementTranslation[]

  @@index([restaurantId, status])
  @@map("restaurant_announcements")
}

model RestaurantAnnouncementTranslation {
  id             String @id @default(uuid()) @db.Uuid
  announcementId String @map("announcement_id") @db.Uuid
  locale         String
  text           String

  announcement RestaurantAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, locale])
  @@map("restaurant_announcement_translations")
}

enum BranchHoursMode {
  ALWAYS_OPEN
  SCHEDULE

  @@map("branch_hours_mode")
}

/// One opening interval of a Branch on one weekday (0 = Sunday ... 6 = Saturday), in
/// minutes after local midnight in the Branch timezone. `closesMinute` above 1440
/// means the interval ends after midnight (it belongs to the day it opens on).
/// The range rules are a CHECK constraint in the migration.
model BranchOpeningHour {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @map("restaurant_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  dayOfWeek    Int    @map("day_of_week") @db.SmallInt
  opensMinute  Int    @map("opens_minute")
  closesMinute Int    @map("closes_minute")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, dayOfWeek])
  @@index([restaurantId])
  @@map("branch_opening_hours")
}

// -----------------------------------------------------------------------------
// Menu / Category / Product (DATABASE_SPEC.md #58-67; MENU_SPEC.md #1-20,
// #41-44; I18N_SPEC.md #20-23)
// -----------------------------------------------------------------------------

model Menu {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  // Internal-only label, never customer-facing (DATABASE_SPEC.md #58).
  // Customer-facing name/description live in MenuTranslation.
  nameInternal String     @map("name_internal")
  // No database default: Menu creation must explicitly choose the initial
  // status at the application/domain layer (mirrors Restaurant/Branch/Table).
  status       MenuStatus
  displayOrder Int        @map("display_order")
  // At most one isPrimary=true Menu per Restaurant is enforced by the
  // menus_one_primary_menu partial unique index (custom migration SQL,
  // DATABASE_SPEC.md #41 policy) -- Prisma's schema syntax cannot express a
  // partial (WHERE-predicated) unique index. "Every Restaurant must always
  // have a primary Menu" is NOT a database invariant here; it is Batch C
  // application/service logic (the first created Menu becomes primary).
  isPrimary    Boolean    @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  translations MenuTranslation[]
  categories   Category[]
  importJobs   MenuImportJob[]

  @@index([restaurantId])
  @@map("menus")
}

model MenuTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  menuId      String  @map("menu_id") @db.Uuid
  // Normalized locale string (e.g. "ar", "en"), matching
  // RestaurantLocale.locale -- not a fixed enum (I18N_SPEC.md #20-23).
  locale      String
  name        String
  description String?

  // Pure translation child of Menu, no independent historical value and
  // never referenced by Orders -- Cascade is acceptable here
  // (DATABASE_SPEC.md #136), unlike the Restrict used for every
  // Tenant-owned parent entity itself.
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, locale])
  @@map("menu_translations")
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  restaurantId   String         @map("restaurant_id") @db.Uuid
  menuId         String         @map("menu_id") @db.Uuid
  // No database default, mirrors Menu.status.
  status         CategoryStatus
  displayOrder   Int            @map("display_order")
  imageAssetPath String?        @map("image_asset_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Category.restaurantId == Menu.restaurantId is a cross-row Tenant
  // invariant that cannot be expressed as a schema constraint here (mirrors
  // AUTH_TENANCY_SPEC.md #61A) -- enforced by Batch C application write
  // logic and by Tenant-scoped read queries, never trusted from menuId
  // alone.
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  menu         Menu                  @relation(fields: [menuId], references: [id], onDelete: Restrict)
  translations CategoryTranslation[]
  products     Product[]

  @@index([restaurantId])
  @@index([menuId])
  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  locale      String
  name        String
  description String?

  // Pure translation child of Category -- Cascade (DATABASE_SPEC.md #136),
  // same rationale as MenuTranslation.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

// A Platform Administrator (DEC-045): the platform team, a separate authorization domain from Restaurant users.
model PlatformAdmin {
  id              String              @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String              @unique @map("email_normalized")
  passwordHash    String              @map("password_hash")
  displayName     String              @map("display_name")
  status          PlatformAdminStatus
  lastLoginAt     DateTime?           @map("last_login_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  sessions      PlatformSession[]
  auditLog      PlatformAuditLog[]
  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  @@map("platform_admins")
}

// Opaque database session of a Platform Administrator; only the token hash is stored.
model PlatformSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

// What the platform team did. The email and Restaurant name are copied so the entry stays readable later.
model PlatformAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  adminId        String?  @map("admin_id") @db.Uuid
  adminEmail     String   @map("admin_email")
  action         String
  restaurantId   String?  @map("restaurant_id") @db.Uuid
  restaurantName String?  @map("restaurant_name")
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin      PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  restaurant Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@map("platform_audit_log")
}

// Singleton public Platform branding settings. Restaurant content never controls this destination.
model PlatformPublicSettings {
  id           String   @id @default("public")
  poweredByUrl String   @map("powered_by_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_public_settings")
}

// Singleton defaults for trials. A trial itself remains a Subscription so dates, Package access,
// overlap protection and history keep one authority (DEC-056).
model PlatformTrialSettings {
  id               String   @id @default("trial")
  enabled          Boolean  @default(true)
  defaultDays      Int      @default(15) @map("default_days")
  defaultPackageId String?  @map("default_package_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  defaultPackage Package? @relation(fields: [defaultPackageId], references: [id], onDelete: SetNull)

  @@map("platform_trial_settings")
}

// A per-Restaurant override of what the platform allows (DEC-043). No row = the default (every feature).
model RestaurantFeature {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  feature      FeatureKey
  enabled      Boolean
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, feature])
  @@map("restaurant_features")
}

// A bundle of platform features the platform team assigns to Restaurants (DEC-046). Prices are for display only.
model Package {
  id                   String        @id @default(uuid()) @db.Uuid
  // Platform-owned public copy. Arabic and English are both required for the name;
  // descriptions stay optional per locale. The Prisma `name`/`description` aliases
  // keep internal snapshots and billing code on the Arabic canonical value.
  name                 String        @map("name_ar")
  nameNormalized       String        @unique @map("name_ar_normalized")
  nameEn               String        @map("name_en")
  nameEnNormalized     String        @unique @map("name_en_normalized")
  description          String?       @map("description_ar")
  descriptionEn        String?       @map("description_en")
  status               PackageStatus @default(ACTIVE)
  // List prices per billing currency and period (DEC-049). Null = not offered in that currency/period.
  priceEgpMonthly      Decimal?      @map("price_egp_monthly") @db.Decimal(12, 2)
  priceEgpYearly       Decimal?      @map("price_egp_yearly") @db.Decimal(12, 2)
  priceUsdMonthly      Decimal?      @map("price_usd_monthly") @db.Decimal(12, 2)
  priceUsdYearly       Decimal?      @map("price_usd_yearly") @db.Decimal(12, 2)
  // An offer on the package: a percentage off the list price, optionally ending on a date.
  offerPercent         Decimal?      @map("offer_percent") @db.Decimal(5, 2)
  offerLabel           String?       @map("offer_label")
  offerEndsAt          DateTime?     @map("offer_ends_at") @db.Date
  // Guest menu templates (DEC-051): every template (also ones added later) or the listed ones; Classic always.
  allTemplates         Boolean       @default(false) @map("all_templates")
  // Every STANDARD template (also future ones) but no premium one (DEC-052); ignored when allTemplates.
  allStandardTemplates Boolean       @default(false) @map("all_standard_templates")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  features             PackageFeature[]
  templates            PackageTemplate[]
  restaurants          Restaurant[]
  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]
  signupLeads          SignupLead[]
  trialSettings        PlatformTrialSettings[]

  @@map("packages")
}

// A feature a package INCLUDES: a row = included, no row = not included.
model PackageFeature {
  id        String     @id @default(uuid()) @db.Uuid
  packageId String     @map("package_id") @db.Uuid
  feature   FeatureKey

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, feature])
  @@map("package_features")
}

// A menu template a package allows (DEC-051). Classic is always allowed, so it is never stored.
model PackageTemplate {
  id        String       @id @default(uuid()) @db.Uuid
  packageId String       @map("package_id") @db.Uuid
  template  MenuTemplate

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, template])
  @@map("package_templates")
}

// Manual billing (DEC-049).
enum BillingPeriod {
  MONTHLY
  YEARLY

  @@map("billing_period")
}

// A cancelled subscription no longer counts. "Expired" is derived from the end date, never stored.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED

  @@map("subscription_status")
}

enum SubscriptionKind {
  PAID
  TRIAL

  @@map("subscription_kind")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  MOBILE_WALLET
  OTHER

  @@map("payment_method")
}

enum DiscountType {
  PERCENT
  AMOUNT

  @@map("discount_type")
}

// A Restaurant's paid period on a Package (DEC-049). Every money value is a snapshot taken when it was
// created, so later Package price or offer changes never alter it. Periods of one Restaurant never
// overlap (database exclusion constraint). Dates are calendar dates; the period is [startsAt, endsAt).
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  restaurantId     String             @map("restaurant_id") @db.Uuid
  packageId        String             @map("package_id") @db.Uuid
  packageName      String             @map("package_name")
  kind             SubscriptionKind   @default(PAID)
  // Trials have no billing cadence. Paid subscriptions always have one (database CHECK).
  period           BillingPeriod?
  startsAt         DateTime           @map("starts_at") @db.Date
  endsAt           DateTime           @map("ends_at") @db.Date
  status           SubscriptionStatus @default(ACTIVE)
  currencyCode     String             @map("currency_code") @db.Char(3)
  listPrice        Decimal            @map("list_price") @db.Decimal(12, 2)
  offerLabel       String?            @map("offer_label")
  offerPercent     Decimal?           @map("offer_percent") @db.Decimal(5, 2)
  offerAmount      Decimal            @default(0) @map("offer_amount") @db.Decimal(12, 2)
  discountType     DiscountType?      @map("discount_type")
  discountValue    Decimal?           @map("discount_value") @db.Decimal(12, 2)
  discountAmount   Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalPrice       Decimal            @map("final_price") @db.Decimal(12, 2)
  notes            String?
  createdByAdminId String?            @map("created_by_admin_id") @db.Uuid
  createdByEmail   String             @map("created_by_email")
  cancelledAt      DateTime?          @map("cancelled_at") @db.Timestamptz
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  package    Package               @relation(fields: [packageId], references: [id], onDelete: Restrict)
  createdBy  PlatformAdmin?        @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  payments   SubscriptionPayment[]
  contract   Contract?

  @@index([restaurantId, startsAt])
  @@index([packageId])
  @@map("subscriptions")
}

// One line of the payment ledger. Never edited or deleted: a mistake is voided with a reason.
model SubscriptionPayment {
  id                String        @id @default(uuid()) @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  paidAt            DateTime      @map("paid_at") @db.Date
  reference         String?
  notes             String?
  recordedByAdminId String?       @map("recorded_by_admin_id") @db.Uuid
  recordedByEmail   String        @map("recorded_by_email")
  voidedAt          DateTime?     @map("voided_at") @db.Timestamptz
  voidReason        String?       @map("void_reason")
  voidedByEmail     String?       @map("voided_by_email")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  recordedBy   PlatformAdmin? @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, paidAt])
  @@map("subscription_payments")
}

// The contract of a Subscription: a running number and a snapshot of its terms, shown as a printable page.
model Contract {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @unique @map("subscription_id") @db.Uuid
  number         String   @unique
  terms          Json
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

// What a Restaurant asks the platform team for from "My subscription" (DEC-050).
enum SubscriptionRequestKind {
  UPGRADE
  RENEWAL

  @@map("subscription_request_kind")
}

enum SubscriptionRequestStatus {
  NEW
  CONTACTED
  DONE
  DISMISSED

  @@map("subscription_request_status")
}

// A request to upgrade or renew. Nothing changes by itself: the team records the real subscription.
// The requester's e-mail and the package name are kept as a snapshot. At most one open request
// (NEW or CONTACTED) per Restaurant, enforced by a partial unique index.
model SubscriptionRequest {
  id                String                    @id @default(uuid()) @db.Uuid
  restaurantId      String                    @map("restaurant_id") @db.Uuid
  kind              SubscriptionRequestKind
  packageId         String?                   @map("package_id") @db.Uuid
  packageName       String?                   @map("package_name")
  message           String?
  requestedByUserId String?                   @map("requested_by_user_id") @db.Uuid
  requestedByEmail  String                    @map("requested_by_email")
  status            SubscriptionRequestStatus @default(NEW)
  note              String?
  handledByEmail    String?                   @map("handled_by_email")
  handledAt         DateTime?                 @map("handled_at") @db.Timestamptz
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  package     Package?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  requestedBy User?      @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([status, createdAt])
  @@map("subscription_requests")
}

// A visitor of the public landing page asking to subscribe or to try the platform (DEC-053).
enum SignupLeadKind {
  SUBSCRIBE
  TRIAL

  @@map("signup_lead_kind")
}

model SignupLead {
  id             String                    @id @default(uuid()) @db.Uuid
  kind           SignupLeadKind
  packageId      String?                   @map("package_id") @db.Uuid
  packageName    String?                   @map("package_name")
  name           String
  email          String
  phone          String
  restaurantName String?                   @map("restaurant_name")
  message        String?
  locale         String                    @default("ar")
  status         SubscriptionRequestStatus @default(NEW)
  note           String?
  handledByEmail String?                   @map("handled_by_email")
  handledAt      DateTime?                 @map("handled_at") @db.Timestamptz
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("signup_leads")
}

// Manual suggestion rule (DEC-042): when `product` is in the Guest cart, suggest `suggestedProduct`.
// Same-Restaurant is enforced by the application (tenant-scoped writes), like other Product links.
model ProductSuggestion {
  id                 String   @id @default(uuid()) @db.Uuid
  restaurantId       String   @map("restaurant_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  suggestedProductId String   @map("suggested_product_id") @db.Uuid
  position           Int
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product          Product    @relation("SuggestionTrigger", fields: [productId], references: [id], onDelete: Cascade)
  suggestedProduct Product    @relation("SuggestionTarget", fields: [suggestedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, suggestedProductId])
  @@index([restaurantId, productId])
  @@map("product_suggestions")
}

model Product {
  id                    String               @id @default(uuid()) @db.Uuid
  publicId              String               @unique @map("public_id")
  restaurantId          String               @map("restaurant_id") @db.Uuid
  categoryId            String               @map("category_id") @db.Uuid
  // No database default, mirrors Menu/Category.status.
  status                ProductStatus
  // Independent from status (DATABASE_SPEC.md #63-64, MENU_SPEC.md #11):
  // ACTIVE/INACTIVE is configuration visibility, AVAILABLE/SOLD_OUT is
  // orderability. No database default: Product creation must explicitly
  // choose the initial availability at the application/domain layer.
  availability          ProductAvailability
  // Fixed-precision money (DATABASE_SPEC.md #13-14) -- never Float/Double.
  // Non-negative enforced by the products_base_price_non_negative CHECK
  // constraint (custom migration SQL), not by application validation alone.
  basePrice             Decimal              @map("base_price") @db.Decimal(14, 2)
  primaryImageAssetPath String?              @map("primary_image_asset_path")
  displayOrder          Int                  @map("display_order")
  allowCustomerNotes    Boolean              @map("allow_customer_notes")
  featured              Boolean
  // Product Discounts V1: one optional product-level discount. The shape,
  // 0 < value (<= 100 for PERCENTAGE) and end >= start are CHECK constraints in
  // the migration. Dates are calendar dates interpreted in the Branch timezone
  // when pricing is evaluated (never stored as instants), so expiry is
  // automatic and needs no job. `discountEnabled` is the manual switch.
  discountType          ProductDiscountType? @map("discount_type")
  discountValue         Decimal?             @map("discount_value") @db.Decimal(14, 2)
  discountEnabled       Boolean              @default(false) @map("discount_enabled")
  discountStartsOn      DateTime?            @map("discount_starts_on") @db.Date
  discountEndsOn        DateTime?            @map("discount_ends_on") @db.Date
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Product.restaurantId == Category.restaurantId is a cross-row Tenant
  // invariant enforced by Batch D application write logic and Tenant-scoped
  // read queries, never trusted from categoryId alone (mirrors #61A).
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations   ProductTranslation[]
  orderItems     OrderItem[]
  modifierGroups ModifierGroup[]
  variants       ProductVariant[]
  // Manual suggestion rules where this product is the trigger / the suggestion.
  suggestions    ProductSuggestion[]  @relation("SuggestionTrigger")
  suggestedBy    ProductSuggestion[]  @relation("SuggestionTarget")

  @@index([restaurantId])
  @@index([categoryId])
  @@map("products")
}

model ProductTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  locale      String
  name        String
  description String?

  // Pure translation child of Product -- Cascade (DATABASE_SPEC.md #136),
  // same rationale as MenuTranslation/CategoryTranslation.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

// -----------------------------------------------------------------------------
// Product Variant (DEC-041; MENU_SPEC.md #21-24, DATABASE_SPEC.md #68-71, #111).
// A meaningful variation of a Product -- typically a size (Small / Medium /
// Large). Its price is a NON-NEGATIVE adjustment from Product.basePrice, so the
// smallest size normally has adjustment 0. Translated names live in
// ProductVariantTranslation (never name_ar / name_en columns). Never
// hard-deleted once an Order references it (status deactivation instead), so a
// historical OrderItem snapshot never loses its reference.
// -----------------------------------------------------------------------------

model ProductVariant {
  id              String               @id @default(uuid()) @db.Uuid
  restaurantId    String               @map("restaurant_id") @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  // No database default, mirrors Product.status: an explicit choice at the
  // application layer.
  status          ProductVariantStatus
  // The FULL price of this size (never an adjustment). Fixed-precision money,
  // never Float/Double. Non-negative is enforced by the
  // product_variants_price_non_negative CHECK (custom migration SQL).
  price           Decimal              @map("price") @db.Decimal(14, 2)
  displayOrder    Int                  @map("display_order")
  // At most one default Variant per Product: product_variants_one_default_per_product
  // partial unique index (custom migration SQL; Prisma cannot express it).
  isDefault       Boolean              @map("is_default")
  // DEC-041: does the Product discount apply to this size? Default true = all
  // sizes; false excludes this size. Meaningless without a Product discount.
  discountApplies Boolean              @default(true) @map("discount_applies")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Variant.restaurantId == Product.restaurantId is a cross-row Tenant
  // invariant enforced by application write logic and Tenant-scoped reads,
  // never trusted from productId alone (mirrors ModifierGroup).
  restaurant   Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  product      Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  translations ProductVariantTranslation[]
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([productId])
  @@map("product_variants")
}

model ProductVariantTranslation {
  id               String @id @default(uuid()) @db.Uuid
  productVariantId String @map("product_variant_id") @db.Uuid
  locale           String
  name             String

  // Pure translation child of ProductVariant -- Cascade (DATABASE_SPEC.md #136).
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, locale])
  @@map("product_variant_translations")
}

// -----------------------------------------------------------------------------
// Modifier Group / Option (FT-6A; DATABASE_SPEC.md #72-79, MENU_SPEC.md
// #25-28/#32/#58/#78-79). V1: a Modifier Group belongs to exactly one
// Product (DATABASE_SPEC.md #72's "V1 preferred simple ownership") -- no
// cross-Product reuse. Extras and Ingredient Removal are both plain Modifier
// Groups/Options (#78-79), never separate entities. Status is ACTIVE/
// INACTIVE, mirroring Category/Product -- Groups/Options are never
// hard-deleted so a historical Order's snapshot (OrderItemModifier, below)
// never loses its referenced row (#58).
// -----------------------------------------------------------------------------

enum ModifierGroupStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_group_status")
}

enum ModifierOptionStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_option_status")
}

model ModifierGroup {
  id                String              @id @default(uuid()) @db.Uuid
  restaurantId      String              @map("restaurant_id") @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  // No database default, mirrors Product.status -- an explicit
  // application-layer choice at creation time.
  status            ModifierGroupStatus
  // Selection rules (MENU_SPEC.md #26, DATABASE_SPEC.md #74): required =
  // minimumSelections >= 1, optional = 0, single-select = maximumSelections
  // = 1, multi-select = maximumSelections > 1. No separate `required`
  // boolean or `selectionType` enum -- these two integers alone express
  // every V1 rule without redundant fields that could drift out of sync.
  minimumSelections Int                 @map("minimum_selections")
  maximumSelections Int                 @map("maximum_selections")
  displayOrder      Int                 @map("display_order")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  // FT-6B: set only when this Group was created via "Use Preset" -- null
  // for a Group created via "Create Custom" (FT-6A behavior, unchanged).
  // This Group row (and its Options below) remain the ONE runtime
  // authority Public Menu/Cart/PublicOrdersService/OrderItemModifier ever
  // read (Section 3: presets are a Staff-side authoring convenience, never
  // a second pricing/ordering entity). SetNull, not Restrict: an optional
  // soft link -- if the source Preset were ever removed, the linked Group
  // simply detaches and keeps its last-synced values, never blocked.
  sourcePresetId    String?             @map("source_preset_id") @db.Uuid

  // Restrict, not Cascade -- a Modifier Group is a substantive business
  // entity (like Product itself), never a pure translation row. It must
  // never be destructively removed in a way that could break a historical
  // Order's OrderItemModifier snapshot (#58); the only supported removal
  // path is the `status` field.
  restaurant         Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  product            Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourcePreset       ModifierPreset?            @relation(fields: [sourcePresetId], references: [id], onDelete: SetNull)
  translations       ModifierGroupTranslation[]
  options            ModifierOption[]
  orderItemModifiers OrderItemModifier[]

  // Prevents accidentally attaching the SAME Preset twice to the SAME
  // Product (FT-6B, Section 2/4) -- Postgres treats each NULL
  // `sourcePresetId` as distinct, so any number of Custom (non-Preset)
  // Groups on one Product remain unaffected by this constraint.
  @@unique([productId, sourcePresetId])
  @@index([restaurantId])
  @@index([productId])
  @@index([sourcePresetId])
  @@map("modifier_groups")
}

model ModifierGroupTranslation {
  id              String  @id @default(uuid()) @db.Uuid
  modifierGroupId String  @map("modifier_group_id") @db.Uuid
  locale          String
  name            String
  helperText      String? @map("helper_text")

  // Pure translation child of ModifierGroup -- Cascade, same rationale as
  // ProductTranslation/CategoryTranslation.
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([modifierGroupId, locale])
  @@map("modifier_group_translations")
}

model ModifierOption {
  id                   String               @id @default(uuid()) @db.Uuid
  restaurantId         String               @map("restaurant_id") @db.Uuid
  modifierGroupId      String               @map("modifier_group_id") @db.Uuid
  status               ModifierOptionStatus
  // Fixed-precision money (CLAUDE.md #27) -- never Float/Double. May be
  // zero (Ingredient Removal options, MENU_SPEC.md #79) or positive
  // (Extras, #78); no CHECK constraint restricting sign is documented.
  // FT-6B: this remains the ONE authoritative runtime price PublicOrdersService
  // reads (Section 5/9) -- a Preset's own default price is copied HERE at
  // apply-time and re-synced here on Preset change; the client is never the
  // pricing authority.
  priceAdjustment      Decimal              @map("price_adjustment") @db.Decimal(14, 2)
  displayOrder         Int                  @map("display_order")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  // FT-6B: set only when this Option was created via "Use Preset" -- null
  // for a Custom Option (unchanged FT-6A behavior).
  sourcePresetOptionId String?              @map("source_preset_option_id") @db.Uuid
  // True once Staff has explicitly overridden this ONE Product's price away
  // from the linked Preset Option's current default (Section 5) -- while
  // true, a Preset-wide price sync (Section 7) skips this row entirely.
  // No database default (mirrors every other business-meaning column in
  // this schema) -- always explicitly set `false` at creation time by
  // application code, `true` only by the explicit override action.
  priceIsOverridden    Boolean              @map("price_is_overridden")

  // Restrict, same rationale as ModifierGroup -- an Option must survive
  // regardless of later Group/Option lifecycle changes so historical
  // OrderItemModifier rows never lose their reference.
  restaurant         Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  modifierGroup      ModifierGroup               @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  sourcePresetOption ModifierPresetOption?       @relation(fields: [sourcePresetOptionId], references: [id], onDelete: SetNull)
  translations       ModifierOptionTranslation[]
  orderItemModifiers OrderItemModifier[]

  @@index([restaurantId])
  @@index([modifierGroupId])
  @@index([sourcePresetOptionId])
  @@map("modifier_options")
}

model ModifierOptionTranslation {
  id               String @id @default(uuid()) @db.Uuid
  modifierOptionId String @map("modifier_option_id") @db.Uuid
  locale           String
  name             String

  // Pure translation child of ModifierOption -- Cascade, same rationale as
  // ModifierGroupTranslation.
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  @@unique([modifierOptionId, locale])
  @@map("modifier_option_translations")
}

// -----------------------------------------------------------------------------
// Modifier Preset (FT-6B): a reusable, Restaurant-scoped Modifier Group
// TEMPLATE (e.g. "Standard Size") that Staff can attach to many Products at
// once instead of hand-building the same Group/Options repeatedly. A Preset
// is authoring convenience ONLY -- it is never read by Public Menu, Cart,
// PublicOrdersService, or OrderItemModifier. Applying a Preset to a Product
// COPIES its current values into real, independent `ModifierGroup`/
// `ModifierOption` rows (linked back via `sourcePresetId`/
// `sourcePresetOptionId` above) -- those Product-local rows remain the one
// runtime authority, unchanged from FT-6A. Same translation-table and
// status-only-deactivation conventions as every other Menu entity.
// -----------------------------------------------------------------------------

enum ModifierPresetStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_preset_status")
}

enum ModifierPresetOptionStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_preset_option_status")
}

model ModifierPreset {
  id                String               @id @default(uuid()) @db.Uuid
  restaurantId      String               @map("restaurant_id") @db.Uuid
  // No database default, mirrors ModifierGroup.status.
  status            ModifierPresetStatus
  minimumSelections Int                  @map("minimum_selections")
  maximumSelections Int                  @map("maximum_selections")
  displayOrder      Int                  @map("display_order")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  translations ModifierPresetTranslation[]
  options      ModifierPresetOption[]
  // Every Product-local ModifierGroup created via "Use Preset" from this
  // Preset -- Section 7's sync propagates this Preset's own field changes
  // to every row in this list.
  linkedGroups ModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_presets")
}

model ModifierPresetTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  modifierPresetId String  @map("modifier_preset_id") @db.Uuid
  locale           String
  name             String
  helperText       String? @map("helper_text")

  modifierPreset ModifierPreset @relation(fields: [modifierPresetId], references: [id], onDelete: Cascade)

  @@unique([modifierPresetId, locale])
  @@map("modifier_preset_translations")
}

model ModifierPresetOption {
  id               String                     @id @default(uuid()) @db.Uuid
  restaurantId     String                     @map("restaurant_id") @db.Uuid
  modifierPresetId String                     @map("modifier_preset_id") @db.Uuid
  status           ModifierPresetOptionStatus
  priceAdjustment  Decimal                    @map("price_adjustment") @db.Decimal(14, 2)
  displayOrder     Int                        @map("display_order")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant     Restaurant                        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  modifierPreset ModifierPreset                    @relation(fields: [modifierPresetId], references: [id], onDelete: Restrict)
  translations   ModifierPresetOptionTranslation[]
  // Every Product-local ModifierOption created from this Preset Option --
  // Section 7's price sync updates every row here EXCEPT ones with
  // `priceIsOverridden = true`.
  linkedOptions  ModifierOption[]

  @@index([restaurantId])
  @@index([modifierPresetId])
  @@map("modifier_preset_options")
}

model ModifierPresetOptionTranslation {
  id                     String @id @default(uuid()) @db.Uuid
  modifierPresetOptionId String @map("modifier_preset_option_id") @db.Uuid
  locale                 String
  name                   String

  modifierPresetOption ModifierPresetOption @relation(fields: [modifierPresetOptionId], references: [id], onDelete: Cascade)

  @@unique([modifierPresetOptionId, locale])
  @@map("modifier_preset_option_translations")
}

// -----------------------------------------------------------------------------
// Table / QR (DATABASE_SPEC.md #34-36, #51-56; QR_SPEC.md #2-3, #11-12,
// #50-51, #55-56, #67, #72, #75)
// -----------------------------------------------------------------------------

model Table {
  id                String      @id @default(uuid()) @db.Uuid
  restaurantId      String      @map("restaurant_id") @db.Uuid
  branchId          String      @map("branch_id") @db.Uuid
  tableNumber       String      @map("table_number")
  // No database default (mirrors Restaurant/Branch, DATABASE_SPEC.md
  // #24/#27A): Table creation must explicitly choose the initial status at
  // the application/domain layer. Business Foundation L3 always creates a
  // new Table as ACTIVE.
  status            TableStatus
  // Table Sessions (Slice 1): table QR ordering availability, separate from the
  // session lifecycle and from payment. Set true by a staff close and cleared
  // by a manual open (later slices). While true and no OPEN session exists, a
  // Table QR order is rejected (TABLE_ORDERING_UNAVAILABLE). Default false keeps
  // every existing table orderable exactly as before.
  staffOpenRequired Boolean     @default(false) @map("staff_open_required")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  qrCodes    QrCode[]
  orders     Order[]
  sessions   TableSession[]

  // DATABASE_SPEC.md #35: Table Number unique within a Branch. This compound
  // index's leading column (branchId) already serves branchId-only lookups,
  // so no separate @@index([branchId]) is added.
  @@unique([branchId, tableNumber])
  // Target of the TableSession composite foreign key: a session's
  // restaurant/branch always equal its Table's own.
  @@unique([id, restaurantId, branchId])
  @@index([restaurantId])
  @@map("tables")
}

model QrCode {
  id           String   @id @default(uuid()) @db.Uuid
  publicCode   String   @unique @map("public_code")
  restaurantId String   @map("restaurant_id") @db.Uuid
  // Nullable: required for TABLE (populated from the Table's own branchId,
  // QR_SPEC.md #67), but a future Restaurant-wide GENERIC QR (QR_SPEC.md #4)
  // has no Branch -- enforced by qr_codes_type_context_check, not by
  // NOT NULL here.
  branchId     String?  @map("branch_id") @db.Uuid
  // Nullable: required for TABLE, must be null for GENERIC
  // (QR_SPEC.md #55) -- enforced by qr_codes_type_context_check.
  tableId      String?  @map("table_id") @db.Uuid
  type         QrType
  // No database default, same rationale as Table.status. Business
  // Foundation L3 always creates the initial Table QR as ACTIVE.
  status       QrStatus
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders     Order[]

  // DATABASE_SPEC.md #54/#75: publicCode is globally unique (the @unique
  // above). #56: at most one ACTIVE TABLE QR per Table is enforced by the
  // qr_codes_one_active_table_qr partial unique index, added via committed
  // custom migration SQL -- Prisma's schema syntax cannot express a partial
  // (WHERE-predicated) unique index.
  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@map("qr_codes")
}

// -----------------------------------------------------------------------------
// Order (FT-5, ORDER_LIFECYCLE_SPEC.md #1-51): the minimal V1 slice --
// Dine-In, Table-QR-only ordering. Deliberately does NOT implement Table
// Session, Order Rounds, Kitchen Tickets, Modifiers, or Promotions -- those
// remain later slices layered on top of this same Order/OrderItem shape,
// never a reason to redesign it now. Every Order belongs directly to one
// Table (no session indirection yet).
// -----------------------------------------------------------------------------

model Order {
  id                        String      @id @default(uuid()) @db.Uuid
  restaurantId              String      @map("restaurant_id") @db.Uuid
  branchId                  String      @map("branch_id") @db.Uuid
  // FT-7: nullable -- a PICKUP Order (GENERIC QR, no Table) never has one.
  // A DINE_IN Order (TABLE QR) always has one; enforced at the application
  // layer alongside `type`, not by a DB CHECK constraint (mirrors how
  // `branchId`/`tableId` nullability on QrCode is already enforced by
  // `qr_codes_type_context_check`, but this Fast Track batch keeps the new
  // invariant app-side rather than adding a second custom CHECK).
  tableId                   String?     @map("table_id") @db.Uuid
  qrCodeId                  String      @map("qr_code_id") @db.Uuid
  // Guest-generated idempotency key (Section 11/14): one UUID per genuine
  // submission attempt from the browser. `clientRequestId` is client-
  // controlled -- UUID randomness is not itself an authorization/integrity
  // boundary -- so uniqueness is scoped to `qrCodeId` + `branchId`, NOT
  // `restaurantId` alone (FT-5 critical fix): two different TABLE QRs in the
  // same Restaurant may legitimately submit the same `clientRequestId`
  // value, and a retry must only ever resolve to the ORIGINAL Order from
  // that SAME QR, never a different Table's Order that happens to share a
  // Restaurant and a client-chosen id. FT-7 adds `branchId` to this scope:
  // one GENERIC QR is shared across every Pickup Branch of a Restaurant, so
  // `qrCodeId` alone can no longer tell two genuinely different Pickup
  // submissions (different Branch, coincidentally the same client-chosen
  // id) apart -- for a TABLE QR, `branchId` is already fixed by the Table,
  // so this is a pure extension, never a behavior change for DINE_IN.
  clientRequestId           String      @map("client_request_id") @db.Uuid
  // FT-7: DINE_IN (TABLE QR, existing behavior) or PICKUP (GENERIC QR).
  status                    OrderStatus
  type                      OrderType
  // Snapshot of Restaurant.currencyCode at submission time (Section 9) --
  // never re-derived from the current Restaurant row when displaying a
  // historical Order.
  currencyCode              String      @map("currency_code") @db.Char(3)
  // Exact authoritative sum of every OrderItem.lineTotal, computed
  // server-side only (Section 8) -- never trusted from the client, never
  // Float/Double.
  totalAmount               Decimal     @map("total_amount") @db.Decimal(14, 2)
  // FT-7: PICKUP-only Guest-submitted checkout snapshots (Section 4) --
  // always null for a DINE_IN Order. Stored as plain snapshot strings, the
  // same pattern as every other `*Snapshot` field in this schema
  // (productNameSnapshot etc.) -- a later Guest Session concept could
  // reference back to a submission, but there is no such authority to
  // re-derive these from today.
  customerNameSnapshot      String?     @map("customer_name_snapshot")
  customerPhoneSnapshot     String?     @map("customer_phone_snapshot")
  customerNotesSnapshot     String?     @map("customer_notes_snapshot")
  // FT-8: exact money breakdown -- `subtotalAmount` (items only) +
  // `deliveryFeeAmount` = `totalAmount`. Always set by the application; for
  // DINE_IN/PICKUP the fee is 0.00 and the subtotal equals the total (existing
  // Orders were backfilled that way).
  subtotalAmount            Decimal     @map("subtotal_amount") @db.Decimal(14, 2)
  deliveryFeeAmount         Decimal     @map("delivery_fee_amount") @db.Decimal(14, 2)
  // Product Discounts V1: sum of the items' discountAmount (informational;
  // `subtotalAmount` is already the payable items total after discounts).
  discountTotalAmount       Decimal     @default(0) @map("discount_total_amount") @db.Decimal(14, 2)
  // FT-8: DELIVERY-only snapshots (null otherwise). The zone reference is
  // for traceability only -- historical rendering always uses the snapshots.
  deliveryZoneId            String?     @map("delivery_zone_id") @db.Uuid
  deliveryZoneNameSnapshot  String?     @map("delivery_zone_name_snapshot")
  deliveryAddressSnapshot   String?     @map("delivery_address_snapshot")
  deliveryBuildingSnapshot  String?     @map("delivery_building_snapshot")
  deliveryFloorSnapshot     String?     @map("delivery_floor_snapshot")
  deliveryApartmentSnapshot String?     @map("delivery_apartment_snapshot")
  deliveryLandmarkSnapshot  String?     @map("delivery_landmark_snapshot")
  // Table Sessions (Slice 1): DINE_IN orders created after this slice belong to
  // exactly one TableSession and carry a round number unique within it.
  // Legacy DINE_IN orders (and every PICKUP/DELIVERY order) keep both null --
  // never migrated into sessions (decision D8). The pair-null CHECK, the
  // DINE_IN-only CHECK and the triggers live in the migration SQL.
  tableSessionId            String?     @map("table_session_id") @db.Uuid
  roundNumber               Int?        @map("round_number")
  createdAt                 DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Restrict everywhere (never Cascade): an Order is historical Tenant data,
  // exactly like every other Tenant-owned row in this schema -- its parent
  // Restaurant/Branch/Table/QrCode can never be hard-deleted out from under
  // it.
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table        Table?             @relation(fields: [tableId], references: [id], onDelete: Restrict)
  qrCode       QrCode             @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  deliveryZone DeliveryZone?      @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  // Composite scope: with MATCH SIMPLE semantics the constraint is only
  // checked when every column is non-null (i.e. a DINE_IN order with a
  // session), so it can never attach an order to another tenant's, branch's or
  // table's session.
  tableSession TableSession?      @relation(fields: [tableSessionId, restaurantId, branchId, tableId], references: [id, restaurantId, branchId, tableId], onDelete: Restrict, map: "orders_table_session_scope_fkey")

  @@unique([qrCodeId, branchId, clientRequestId])
  @@unique([tableSessionId, roundNumber])
  @@index([deliveryZoneId])
  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@map("orders")
}

/**
 * FT-11: authoritative, append-only record of every Order.status transition
 * (ORDER_LIFECYCLE_SPEC.md #85-87 "Why Lifecycle Timestamps Matter" /
 * "Audit Events"). One row is written every time `Order.status` actually
 * changes -- inside the SAME database transaction as that write (never a
 * best-effort side write) -- so a status change can never exist without its
 * history event, and a history event never exists without a matching
 * transition. `previousStatus` is null only for the very first event of an
 * Order (its creation into PENDING). `transitionedAt` is always a
 * server-generated timestamp, never client-supplied.
 * Historical Orders created before this table existed were backfilled with
 * exactly one synthetic event -- `previousStatus: null, newStatus: PENDING,
 * transitionedAt: Order.createdAt` -- because that single fact (the Order
 * was created, i.e. became PENDING, at `createdAt`) is the only transition
 * timestamp that can be reconstructed truthfully for them; any intermediate
 * step (when it was ACCEPTED, when it became READY, ...) is genuinely
 * unknown for those rows and is deliberately left absent rather than
 * fabricated (FT-11 Section 3: "Do not fabricate missing historical
 * timings").
 * `restaurantId`/`branchId` are denormalized copies of the owning Order's
 * own values (DATABASE_SPEC.md #21 "Direct restaurantId" convention for
 * high-volume Tenant-owned records) purely so Dashboard timing/analytics
 * queries can filter this table directly without joining through `orders`
 * for every row.
 */
model OrderStatusEvent {
  id             String       @id @default(uuid()) @db.Uuid
  restaurantId   String       @map("restaurant_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  transitionedAt DateTime     @default(now()) @map("transitioned_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([restaurantId, branchId, newStatus, transitionedAt])
  @@map("order_status_events")
}

/**
 * Table Sessions (Slice 1; TABLE_SESSION_CLOSURE_AND_PAYMENT_DESIGN.md v3): one
 * dining visit at one Table. Lifecycle is only OPEN | CLOSED -- payment status
 * is DERIVED from eligible order totals and the payment ledger, never stored.
 * Created automatically by the first valid Dine-In order (`openedVia =
 * FIRST_ORDER`) when Table QR ordering is permitted; staff opening and closing
 * arrive in later slices. A CLOSED session is never reopened.
 * Integrity lives in the migration SQL (Prisma cannot express it):
 * - `table_sessions_one_open_per_table`: UNIQUE (table_id) WHERE status = 'OPEN';
 * - CHECKs tying `closed_at` / `closure_reason` to `status`, and
 * `next_round_number >= 1`;
 * - BEFORE INSERT / BEFORE UPDATE triggers on `orders` (never attach an order
 * to a session that is not OPEN; never re-link or renumber an order).
 * The composite foreign key to Table guarantees restaurant/branch/table agree.
 */
model TableSession {
  id                   String                     @id @default(uuid()) @db.Uuid
  publicId             String                     @unique @map("public_id")
  restaurantId         String                     @map("restaurant_id") @db.Uuid
  branchId             String                     @map("branch_id") @db.Uuid
  tableId              String                     @map("table_id") @db.Uuid
  status               TableSessionStatus
  openedAt             DateTime                   @default(now()) @map("opened_at") @db.Timestamptz
  openedVia            TableSessionOpenedVia      @map("opened_via")
  openedByMembershipId String?                    @map("opened_by_membership_id") @db.Uuid
  closedAt             DateTime?                  @map("closed_at") @db.Timestamptz
  closedByMembershipId String?                    @map("closed_by_membership_id") @db.Uuid
  closureReason        TableSessionClosureReason? @map("closure_reason")
  // The next Order round to hand out; allocated under the table lock by an
  // atomic UPDATE ... RETURNING, so rounds are sequential and never collide.
  nextRoundNumber      Int                        @default(1) @map("next_round_number")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  table    Table                 @relation(fields: [tableId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict, map: "table_sessions_table_scope_fkey")
  openedBy RestaurantMembership? @relation("TableSessionOpenedBy", fields: [openedByMembershipId], references: [id], onDelete: Restrict)
  closedBy RestaurantMembership? @relation("TableSessionClosedBy", fields: [closedByMembershipId], references: [id], onDelete: Restrict)
  orders   Order[]
  payments TableSessionPayment[]
  events   TableSessionEvent[]

  // Targets of the composite foreign keys from orders / payments / events.
  @@unique([id, restaurantId, branchId, tableId])
  @@unique([id, restaurantId, branchId])
  @@index([restaurantId, branchId, status])
  @@index([tableId, openedAt])
  @@map("table_sessions")
}

/**
 * Table Sessions (Slice 1): the append-only settlement ledger FOUNDATION.
 * No API writes to it yet (Slice 4). Recorded manually by staff -- the
 * platform processes nothing, so there are deliberately no gateway fields. A
 * correction is a void (an audited accounting correction, NEVER a refund,
 * decision P5); rows are never edited or deleted.
 */
model TableSessionPayment {
  id                     String                    @id @default(uuid()) @db.Uuid
  restaurantId           String                    @map("restaurant_id") @db.Uuid
  branchId               String                    @map("branch_id") @db.Uuid
  tableSessionId         String                    @map("table_session_id") @db.Uuid
  kind                   TableSessionLedgerKind    @default(PAYMENT)
  amount                 Decimal                   @db.Decimal(14, 2)
  method                 TableSessionPaymentMethod
  // Idempotency: a double click records once (unique per session).
  clientRequestId        String                    @map("client_request_id") @db.Uuid
  note                   String?
  recordedByMembershipId String                    @map("recorded_by_membership_id") @db.Uuid
  recordedAt             DateTime                  @default(now()) @map("recorded_at") @db.Timestamptz
  voidedAt               DateTime?                 @map("voided_at") @db.Timestamptz
  voidedByMembershipId   String?                   @map("voided_by_membership_id") @db.Uuid
  voidReason             String?                   @map("void_reason")

  session    TableSession          @relation(fields: [tableSessionId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict, map: "table_session_payments_session_scope_fkey")
  recordedBy RestaurantMembership  @relation("TableSessionPaymentRecordedBy", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)
  voidedBy   RestaurantMembership? @relation("TableSessionPaymentVoidedBy", fields: [voidedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([tableSessionId, clientRequestId])
  @@index([tableSessionId])
  @@index([restaurantId, branchId])
  @@map("table_session_payments")
}

/**
 * Table Sessions (Slice 1): append-only audit trail, same pattern as
 * `OrderStatusEvent`. Slice 1 writes only SESSION_OPENED (actor GUEST) when the
 * first order opens a session, in the same transaction as the session itself.
 */
model TableSessionEvent {
  id                String                @id @default(uuid()) @db.Uuid
  restaurantId      String                @map("restaurant_id") @db.Uuid
  branchId          String                @map("branch_id") @db.Uuid
  tableSessionId    String                @map("table_session_id") @db.Uuid
  type              TableSessionEventType
  actorType         TableSessionActorType @map("actor_type")
  actorMembershipId String?               @map("actor_membership_id") @db.Uuid
  occurredAt        DateTime              @default(now()) @map("occurred_at") @db.Timestamptz
  // Minimal, non-sensitive context only (reason, amount, policy) -- never PII.
  metadata          Json?

  session TableSession          @relation(fields: [tableSessionId, restaurantId, branchId], references: [id, restaurantId, branchId], onDelete: Restrict, map: "table_session_events_session_scope_fkey")
  actor   RestaurantMembership? @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([tableSessionId, occurredAt])
  @@index([restaurantId, branchId, type, occurredAt])
  @@map("table_session_events")
}

/**
 * FT-8: a Branch's named Delivery area with its own fee and minimum order.
 * No radius/coordinates -- the Guest picks a zone by name. A Branch is
 * eligible for Delivery when it is ACTIVE and has at least one ACTIVE zone.
 * deliveryFee and minimumOrder are exact Decimals with non-negative CHECK
 * constraints (custom migration SQL). Orders keep their own snapshots, so a
 * zone is never needed to render history; Restrict on the Order FK means a
 * zone that has Orders can only be deactivated, never deleted.
 */
model DeliveryZone {
  id           String             @id @default(uuid()) @db.Uuid
  restaurantId String             @map("restaurant_id") @db.Uuid
  branchId     String             @map("branch_id") @db.Uuid
  name         String
  deliveryFee  Decimal            @map("delivery_fee") @db.Decimal(14, 2)
  minimumOrder Decimal            @map("minimum_order") @db.Decimal(14, 2)
  status       DeliveryZoneStatus
  displayOrder Int                @map("display_order")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch       Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orders       Order[]
  translations DeliveryZoneTranslation[]

  @@index([restaurantId])
  @@index([branchId, status])
  @@map("delivery_zones")
}

// Bilingual (per-locale) display names. `branches.name` / `delivery_zones.name`
// stay as the default-locale name and the legacy fallback, so older readers and
// existing single-language data keep working. Pure translation children:
// Cascade, like every other *_translations table.
model BranchTranslation {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  locale   String
  name     String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, locale])
  @@map("branch_translations")
}

model DeliveryZoneTranslation {
  id             String @id @default(uuid()) @db.Uuid
  deliveryZoneId String @map("delivery_zone_id") @db.Uuid
  locale         String
  name           String

  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)

  @@unique([deliveryZoneId, locale])
  @@map("delivery_zone_translations")
}

model OrderItem {
  id                    String               @id @default(uuid()) @db.Uuid
  orderId               String               @map("order_id") @db.Uuid
  productId             String               @map("product_id") @db.Uuid
  // Section 9/ORDER_LIFECYCLE_SPEC.md #39: the Restaurant default-locale
  // Product name at submission time -- a later Product rename must never
  // rewrite historical Order meaning.
  productNameSnapshot   String               @map("product_name_snapshot")
  // Product.basePrice at submission time (Section 8) -- same exact
  // Decimal(14,2) shape as Product itself, never Float/Double.
  unitPrice             Decimal              @map("unit_price") @db.Decimal(14, 2)
  quantity              Int
  // (unitPrice - unit discount + modifiers) * quantity, computed server-side
  // only; equals the historical (unitPrice + modifiers) * quantity when
  // discountAmount is 0.
  lineTotal             Decimal              @map("line_total") @db.Decimal(14, 2)
  // Product Discounts V1: the TOTAL discount taken off this line
  // (unit discount * quantity) and the configuration that produced it. Pure
  // history -- later product or discount edits never touch these.
  discountAmount        Decimal              @default(0) @map("discount_amount") @db.Decimal(14, 2)
  discountTypeSnapshot  ProductDiscountType? @map("discount_type_snapshot")
  discountValueSnapshot Decimal?             @map("discount_value_snapshot") @db.Decimal(14, 2)
  // Product Variants (DEC-041): the chosen Variant and its snapshot. All NULL for
  // a Product without Variants and for every historical item. When a Variant is
  // chosen, `unitPrice` is that size's price before any discount; the size
  // price is also kept in `variantPriceSnapshot`.
  variantId             String?              @map("variant_id") @db.Uuid
  variantNameSnapshot   String?              @map("variant_name_snapshot")
  variantPriceSnapshot  Decimal?             @map("variant_price_snapshot") @db.Decimal(14, 2)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Restrict, mirroring every other Product foreign key in this schema --
  // never Cascade: a historical OrderItem must survive regardless of the
  // referenced Product's own lifecycle.
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

/**
 * FT-6A; ORDER_LIFECYCLE_SPEC.md #41 "Modifier Snapshot": one row per
 * selected Modifier Option on one OrderItem, capturing the Group/Option
 * names and the Option's priceAdjustment exactly as they were at submission
 * time. A later rename, price change, or deactivation of the live
 * ModifierGroup/ModifierOption must never alter what a historical Order
 * displays -- mirrors OrderItem's own productNameSnapshot/unitPrice
 * pattern. `displayOrder` preserves the Group-then-Option presentation
 * order from submission time, independent of any later reordering in the
 * live configuration.
 */
model OrderItemModifier {
  id                         String   @id @default(uuid()) @db.Uuid
  orderItemId                String   @map("order_item_id") @db.Uuid
  modifierGroupId            String   @map("modifier_group_id") @db.Uuid
  modifierOptionId           String   @map("modifier_option_id") @db.Uuid
  modifierGroupNameSnapshot  String   @map("modifier_group_name_snapshot")
  modifierOptionNameSnapshot String   @map("modifier_option_name_snapshot")
  priceAdjustmentSnapshot    Decimal  @map("price_adjustment_snapshot") @db.Decimal(14, 2)
  displayOrder               Int      @map("display_order")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Pure structural child of OrderItem -- Cascade, same rationale as
  // ProductTranslation being a pure child of Product.
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  // Restrict, mirroring OrderItem.productId -- the live row must survive so
  // long as any historical snapshot references it.
  modifierGroup  ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierGroupId])
  @@index([modifierOptionId])
  @@map("order_item_modifiers")
}

// -----------------------------------------------------------------------------
// User / Auth (DATABASE_SPEC.md #31, #33A, #33D, #33E; AUTH_TENANCY_SPEC.md
// #15-21, #32, #142, #145)
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  // Normalized login identity used for authentication lookups
  // (DATABASE_SPEC.md #33E, AUTH_TENANCY_SPEC.md #15).
  emailNormalized String    @unique @map("email_normalized")
  passwordHash    String    @map("password_hash")
  status          UserState
  preferredLocale String?   @map("preferred_locale")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  authSessions         AuthSession[]
  passwordResetTokens  PasswordResetToken[]
  memberships          RestaurantMembership[]
  menuImportJobs       MenuImportJob[]
  sentInvitations      RestaurantInvitation[] @relation("InvitedByUser")
  subscriptionRequests SubscriptionRequest[]

  @@map("users")
}

model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  // Only the hash of the opaque session token is ever stored; the raw token
  // is never persisted (DATABASE_SPEC.md #33A, AUTH_TENANCY_SPEC.md #21).
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // No database default: Auth creation logic explicitly sets the initial
  // lastSeenAt when Auth is implemented.
  lastSeenAt   DateTime  @map("last_seen_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // revokedAt has no dedicated index: AUTH_TENANCY_SPEC.md #114 only
  // mentions it as indexed "where useful", and no query pattern currently
  // justifies a speculative index. userId and expiresAt are explicitly
  // required (DATABASE_SPEC.md #130).
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // Only the hash of the reset token is ever stored (DATABASE_SPEC.md #33D,
  // AUTH_TENANCY_SPEC.md #32).
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Restaurant Membership (DATABASE_SPEC.md #32, #33B; AUTH_TENANCY_SPEC.md
// #37-40, #58-61, #143)
// -----------------------------------------------------------------------------

model RestaurantMembership {
  id           String                     @id @default(uuid()) @db.Uuid
  restaurantId String                     @map("restaurant_id") @db.Uuid
  userId       String                     @map("user_id") @db.Uuid
  // Kind label of `restaurantRole` (see the enum). Never an authority.
  role         RestaurantMembershipRole
  // FT-12C: the Restaurant Role this Membership holds -- the sole source of its
  // Permissions. Restrict: a Role referenced by any Membership cannot be deleted.
  roleId       String                     @map("role_id") @db.Uuid
  status       RestaurantMembershipStatus
  // true = Restaurant-wide Branch access; false = access is restricted to
  // the Branches listed in RestaurantMembershipBranch
  // (AUTH_TENANCY_SPEC.md #58-60). No schema default: every Membership must
  // explicitly decide its Branch scope at creation time.
  allBranches  Boolean                    @map("all_branches")
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant            Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurantRole        RestaurantRole               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branchAccess          RestaurantMembershipBranch[]
  // Table Sessions (Slice 1): back-relations only, no columns on this table.
  sessionsOpened        TableSession[]               @relation("TableSessionOpenedBy")
  sessionsClosed        TableSession[]               @relation("TableSessionClosedBy")
  sessionPaymentsMade   TableSessionPayment[]        @relation("TableSessionPaymentRecordedBy")
  sessionPaymentsVoided TableSessionPayment[]        @relation("TableSessionPaymentVoidedBy")
  sessionEvents         TableSessionEvent[]

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([roleId])
  @@map("restaurant_memberships")
}

// FT-12C: a Restaurant-scoped Role -- WHAT a Membership may do (Branch scope
// is separate, on the Membership). Permissions are canonical keys from the
// code registry (`PERMISSIONS`); the OWNER-kind Role is protected and always
// evaluated as holding every Permission regardless of what is stored.
// A partial unique index (custom SQL, see the FT-12C migration) allows at most
// one Role per starter kind per Restaurant.
model RestaurantRole {
  id             String                   @id @default(uuid()) @db.Uuid
  restaurantId   String                   @map("restaurant_id") @db.Uuid
  name           String
  // Lower-cased trimmed name: names are unique per Restaurant, case-insensitively.
  nameNormalized String                   @map("name_normalized")
  kind           RestaurantMembershipRole
  permissions    String[]
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  restaurant  Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  memberships RestaurantMembership[]

  @@unique([restaurantId, nameNormalized])
  @@index([restaurantId])
  @@map("restaurant_roles")
}

model RestaurantMembershipBranch {
  restaurantMembershipId String @map("restaurant_membership_id") @db.Uuid
  branchId               String @map("branch_id") @db.Uuid

  membership RestaurantMembership @relation(fields: [restaurantMembershipId], references: [id], onDelete: Restrict)
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Cross-Restaurant validation (the Branch must belong to the same
  // Restaurant as the Membership) is a relational invariant that cannot be
  // expressed as a simple column constraint here; it is enforced by
  // application/domain logic (AUTH_TENANCY_SPEC.md #61).
  @@id([restaurantMembershipId, branchId])
  @@index([branchId])
  @@map("restaurant_membership_branches")
}

// -----------------------------------------------------------------------------
// Restaurant Invitation (DATABASE_SPEC.md #33C; AUTH_TENANCY_SPEC.md #76-81,
// #144)
// -----------------------------------------------------------------------------

model RestaurantInvitation {
  id              String                   @id @default(uuid()) @db.Uuid
  restaurantId    String                   @map("restaurant_id") @db.Uuid
  emailNormalized String                   @map("email_normalized")
  role            RestaurantMembershipRole
  allBranches     Boolean                  @map("all_branches")
  // Only the hash of the invitation token is ever stored
  // (DATABASE_SPEC.md #33C).
  tokenHash       String                   @unique @map("token_hash")
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?                @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz
  invitedByUserId String                   @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  invitedBy  User       @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  // Populated only when allBranches = false (DATABASE_SPEC.md #33C,
  // AUTH_TENANCY_SPEC.md #76). On acceptance, selected Branches are
  // materialized into RestaurantMembershipBranch records for the resulting
  // Restaurant Membership.
  branches RestaurantInvitationBranch[]

  @@index([restaurantId])
  @@index([emailNormalized])
  @@index([expiresAt])
  @@map("restaurant_invitations")
}

// Approved temporary representation for the intended Branch access of a
// Branch-scoped RestaurantInvitation (allBranches = false). Pure join table:
// no independent identity or lifecycle, matching RestaurantMembershipBranch.
// Same-Restaurant validation (each Branch must belong to the same Restaurant
// as the Invitation) and materialization into RestaurantMembershipBranch on
// acceptance are application/domain transaction logic, not schema
// constraints (DATABASE_SPEC.md #33C, AUTH_TENANCY_SPEC.md #61, #76).
model RestaurantInvitationBranch {
  restaurantInvitationId String @map("restaurant_invitation_id") @db.Uuid
  branchId               String @map("branch_id") @db.Uuid

  invitation RestaurantInvitation @relation(fields: [restaurantInvitationId], references: [id], onDelete: Restrict)
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([restaurantInvitationId, branchId])
  @@index([branchId])
  @@map("restaurant_invitation_branches")
}

// -----------------------------------------------------------------------------
// Menu Import (DEC-040, MENU_IMPORT_SPEC.md): an uploaded image / PDF / Excel
// file is turned into a Draft that Staff review and approve. The source file is
// never stored. Draft rows are Tenant scoped (restaurant_id on every table) and
// translations use child tables, never language columns. `matched*Id` /
// `created*Id` are plain references to real Menu rows (no foreign key): they are
// only ever read after being re-verified against the Tenant, and a deleted
// target must never block clearing a Draft.
// -----------------------------------------------------------------------------

enum MenuImportStatus {
  PROCESSING
  READY_FOR_REVIEW
  APPROVED
  DISCARDED
  FAILED

  @@map("menu_import_status")
}

enum MenuImportSourceType {
  IMAGE
  PDF
  SPREADSHEET

  @@map("menu_import_source_type")
}

enum MenuImportConfidence {
  HIGH
  MEDIUM
  LOW

  @@map("menu_import_confidence")
}

model MenuImportJob {
  id              String               @id @default(uuid()) @db.Uuid
  publicId        String               @unique @map("public_id")
  restaurantId    String               @map("restaurant_id") @db.Uuid
  targetMenuId    String               @map("target_menu_id") @db.Uuid
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  status          MenuImportStatus
  sourceType      MenuImportSourceType @map("source_type")
  // Display only (sanitized); never used as a storage path.
  sourceFileName  String               @map("source_file_name")
  sourceMimeType  String               @map("source_mime_type")
  sourceSizeBytes Int                  @map("source_size_bytes")
  // 'auto' | 'ar' | 'en'
  languageHint    String               @map("language_hint")
  detectedLocales String[]             @default([]) @map("detected_locales")
  modelName       String?              @map("model_name")
  // A stable machine code only, never raw provider text.
  errorCode       String?              @map("error_code")
  warnings        String[]             @default([])
  startedAt       DateTime             @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime?            @map("finished_at") @db.Timestamptz
  approvedAt      DateTime?            @map("approved_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  targetMenu Menu                 @relation(fields: [targetMenuId], references: [id], onDelete: Restrict)
  createdBy  User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  categories MenuImportCategory[]

  @@index([restaurantId, createdAt])
  @@map("menu_import_jobs")
}

model MenuImportCategory {
  id                String  @id @default(uuid()) @db.Uuid
  restaurantId      String  @map("restaurant_id") @db.Uuid
  jobId             String  @map("job_id") @db.Uuid
  displayOrder      Int     @map("display_order")
  included          Boolean
  // An existing category of the target Menu with the same default-locale name.
  matchedCategoryId String? @map("matched_category_id") @db.Uuid
  // True = add the products to matchedCategoryId; false = create a new category.
  useExisting       Boolean @default(false) @map("use_existing")
  createdCategoryId String? @map("created_category_id") @db.Uuid

  job          MenuImportJob                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  translations MenuImportCategoryTranslation[]
  products     MenuImportProduct[]

  @@index([jobId])
  @@map("menu_import_categories")
}

model MenuImportCategoryTranslation {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  locale     String
  name       String

  category MenuImportCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("menu_import_category_translations")
}

model MenuImportProduct {
  id               String               @id @default(uuid()) @db.Uuid
  restaurantId     String               @map("restaurant_id") @db.Uuid
  categoryId       String               @map("category_id") @db.Uuid
  displayOrder     Int                  @map("display_order")
  // Null when the file showed no price: a blocker until Staff enter one.
  price            Decimal?             @db.Decimal(14, 2)
  // Sizes as extracted: [{ translations: { <locale>: { label } }, price }]. Read-only source for Variants.
  priceOptions     Json                 @default("[]") @map("price_options")
  confidence       MenuImportConfidence
  included         Boolean
  // Extraction-time flags only (MISSING_TRANSLATION); every other flag is computed on read.
  flags            String[]             @default([])
  matchedProductId String?              @map("matched_product_id") @db.Uuid
  createdProductId String?              @map("created_product_id") @db.Uuid

  category     MenuImportCategory             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations MenuImportProductTranslation[]

  @@index([categoryId])
  @@index([restaurantId])
  @@map("menu_import_products")
}

model MenuImportProductTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  locale      String
  name        String
  description String?

  product MenuImportProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("menu_import_product_translations")
}
