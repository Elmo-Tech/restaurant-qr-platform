datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// -----------------------------------------------------------------------------
// Enums (DATABASE_SPEC.md #138, AUTH_TENANCY_SPEC.md #16 / #39 / #45)
// -----------------------------------------------------------------------------

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("restaurant_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum UserState {
  ACTIVE
  INVITED
  DISABLED

  @@map("user_state")
}

enum RestaurantMembershipRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER

  @@map("restaurant_membership_role")
}

enum RestaurantMembershipStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("restaurant_membership_status")
}

enum TableStatus {
  ACTIVE
  INACTIVE

  @@map("table_status")
}

enum QrType {
  TABLE
  GENERIC

  @@map("qr_type")
}

enum QrStatus {
  ACTIVE
  INACTIVE

  @@map("qr_status")
}

enum MenuStatus {
  ACTIVE
  INACTIVE

  @@map("menu_status")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE

  @@map("category_status")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

enum ProductAvailability {
  AVAILABLE
  SOLD_OUT

  @@map("product_availability")
}

// FT-5: matches ORDER_LIFECYCLE_SPEC.md #16 and the already-established
// `orders.accept`/`orders.reject`/`orders.cancel`/`orders.markServed`/
// `kitchen.update` Permission constants exactly -- these values are the
// documented V1 contract, not a Fast Track invention.
enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  REJECTED
  CANCELLED

  @@map("order_status")
}

// -----------------------------------------------------------------------------
// Restaurant / Branch (DATABASE_SPEC.md #23-30)
// -----------------------------------------------------------------------------

model Restaurant {
  id            String           @id @default(uuid()) @db.Uuid
  publicId      String           @unique @map("public_id")
  name          String
  // No database default: DATABASE_SPEC.md #24 defines the allowed values but
  // not a creation default. Restaurant creation must explicitly choose the
  // initial status at the application/domain layer.
  status        RestaurantStatus
  // Authoritative default locale (DATABASE_SPEC.md #26). restaurant_locales
  // stores supported locales only and does not maintain a second isDefault
  // flag.
  defaultLocale String           @map("default_locale")
  currencyCode  String           @map("currency_code") @db.Char(3)
  logoAssetPath String?          @map("logo_asset_path")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  locales               RestaurantLocale[]
  branches              Branch[]
  memberships           RestaurantMembership[]
  invitations           RestaurantInvitation[]
  tables                Table[]
  qrCodes               QrCode[]
  menus                 Menu[]
  categories            Category[]
  products              Product[]
  orders                Order[]
  modifierGroups        ModifierGroup[]
  modifierOptions       ModifierOption[]
  modifierPresets       ModifierPreset[]
  modifierPresetOptions ModifierPresetOption[]

  @@map("restaurants")
}

model RestaurantLocale {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  // Normalized locale string (e.g. "ar", "en"), not a fixed enum, so the
  // Platform can support additional locales without a schema change
  // (I18N_SPEC.md #2, #19).
  locale       String
  // No database default: the onboarding workflow explicitly decides whether
  // a locale is active when the record is created.
  isActive     Boolean  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, locale])
  @@map("restaurant_locales")
}

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  publicId     String       @unique @map("public_id")
  restaurantId String       @map("restaurant_id") @db.Uuid
  name         String
  // V1 BranchStatus intentionally has no SUSPENDED value: SUSPENDED is a
  // Restaurant-level (tenant) state, and there is no documented Branch-level
  // suspended lifecycle (DATABASE_SPEC.md #27A). No database default:
  // Branch creation must explicitly choose the initial status at the
  // application/domain layer.
  status       BranchStatus
  // IANA timezone identifier (e.g. "Africa/Cairo"), not a fixed UTC offset
  // (DATABASE_SPEC.md #28).
  timezone     String
  phone        String?
  address      String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  restaurant         Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  membershipBranches RestaurantMembershipBranch[]
  invitationBranches RestaurantInvitationBranch[]
  tables             Table[]
  qrCodes            QrCode[]
  orders             Order[]

  @@index([restaurantId])
  @@map("branches")
}

// -----------------------------------------------------------------------------
// Menu / Category / Product (DATABASE_SPEC.md #58-67; MENU_SPEC.md #1-20,
// #41-44; I18N_SPEC.md #20-23)
// -----------------------------------------------------------------------------

model Menu {
  id           String     @id @default(uuid()) @db.Uuid
  restaurantId String     @map("restaurant_id") @db.Uuid
  // Internal-only label, never customer-facing (DATABASE_SPEC.md #58).
  // Customer-facing name/description live in MenuTranslation.
  nameInternal String     @map("name_internal")
  // No database default: Menu creation must explicitly choose the initial
  // status at the application/domain layer (mirrors Restaurant/Branch/Table).
  status       MenuStatus
  displayOrder Int        @map("display_order")
  // At most one isPrimary=true Menu per Restaurant is enforced by the
  // menus_one_primary_menu partial unique index (custom migration SQL,
  // DATABASE_SPEC.md #41 policy) -- Prisma's schema syntax cannot express a
  // partial (WHERE-predicated) unique index. "Every Restaurant must always
  // have a primary Menu" is NOT a database invariant here; it is Batch C
  // application/service logic (the first created Menu becomes primary).
  isPrimary    Boolean    @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  translations MenuTranslation[]
  categories   Category[]

  @@index([restaurantId])
  @@map("menus")
}

model MenuTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  menuId      String  @map("menu_id") @db.Uuid
  // Normalized locale string (e.g. "ar", "en"), matching
  // RestaurantLocale.locale -- not a fixed enum (I18N_SPEC.md #20-23).
  locale      String
  name        String
  description String?

  // Pure translation child of Menu, no independent historical value and
  // never referenced by Orders -- Cascade is acceptable here
  // (DATABASE_SPEC.md #136), unlike the Restrict used for every
  // Tenant-owned parent entity itself.
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, locale])
  @@map("menu_translations")
}

model Category {
  id             String         @id @default(uuid()) @db.Uuid
  restaurantId   String         @map("restaurant_id") @db.Uuid
  menuId         String         @map("menu_id") @db.Uuid
  // No database default, mirrors Menu.status.
  status         CategoryStatus
  displayOrder   Int            @map("display_order")
  imageAssetPath String?        @map("image_asset_path")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  // Category.restaurantId == Menu.restaurantId is a cross-row Tenant
  // invariant that cannot be expressed as a schema constraint here (mirrors
  // AUTH_TENANCY_SPEC.md #61A) -- enforced by Batch C application write
  // logic and by Tenant-scoped read queries, never trusted from menuId
  // alone.
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  menu         Menu                  @relation(fields: [menuId], references: [id], onDelete: Restrict)
  translations CategoryTranslation[]
  products     Product[]

  @@index([restaurantId])
  @@index([menuId])
  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  locale      String
  name        String
  description String?

  // Pure translation child of Category -- Cascade (DATABASE_SPEC.md #136),
  // same rationale as MenuTranslation.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Product {
  id                    String              @id @default(uuid()) @db.Uuid
  publicId              String              @unique @map("public_id")
  restaurantId          String              @map("restaurant_id") @db.Uuid
  categoryId            String              @map("category_id") @db.Uuid
  // No database default, mirrors Menu/Category.status.
  status                ProductStatus
  // Independent from status (DATABASE_SPEC.md #63-64, MENU_SPEC.md #11):
  // ACTIVE/INACTIVE is configuration visibility, AVAILABLE/SOLD_OUT is
  // orderability. No database default: Product creation must explicitly
  // choose the initial availability at the application/domain layer.
  availability          ProductAvailability
  // Fixed-precision money (DATABASE_SPEC.md #13-14) -- never Float/Double.
  // Non-negative enforced by the products_base_price_non_negative CHECK
  // constraint (custom migration SQL), not by application validation alone.
  basePrice             Decimal             @map("base_price") @db.Decimal(14, 2)
  primaryImageAssetPath String?             @map("primary_image_asset_path")
  displayOrder          Int                 @map("display_order")
  allowCustomerNotes    Boolean             @map("allow_customer_notes")
  featured              Boolean
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Product.restaurantId == Category.restaurantId is a cross-row Tenant
  // invariant enforced by Batch D application write logic and Tenant-scoped
  // read queries, never trusted from categoryId alone (mirrors #61A).
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category       Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations   ProductTranslation[]
  orderItems     OrderItem[]
  modifierGroups ModifierGroup[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("products")
}

model ProductTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  locale      String
  name        String
  description String?

  // Pure translation child of Product -- Cascade (DATABASE_SPEC.md #136),
  // same rationale as MenuTranslation/CategoryTranslation.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

// -----------------------------------------------------------------------------
// Modifier Group / Option (FT-6A; DATABASE_SPEC.md #72-79, MENU_SPEC.md
// #25-28/#32/#58/#78-79). V1: a Modifier Group belongs to exactly one
// Product (DATABASE_SPEC.md #72's "V1 preferred simple ownership") -- no
// cross-Product reuse. Extras and Ingredient Removal are both plain Modifier
// Groups/Options (#78-79), never separate entities. Status is ACTIVE/
// INACTIVE, mirroring Category/Product -- Groups/Options are never
// hard-deleted so a historical Order's snapshot (OrderItemModifier, below)
// never loses its referenced row (#58).
// -----------------------------------------------------------------------------

enum ModifierGroupStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_group_status")
}

enum ModifierOptionStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_option_status")
}

model ModifierGroup {
  id                String              @id @default(uuid()) @db.Uuid
  restaurantId      String              @map("restaurant_id") @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  // No database default, mirrors Product.status -- an explicit
  // application-layer choice at creation time.
  status            ModifierGroupStatus
  // Selection rules (MENU_SPEC.md #26, DATABASE_SPEC.md #74): required =
  // minimumSelections >= 1, optional = 0, single-select = maximumSelections
  // = 1, multi-select = maximumSelections > 1. No separate `required`
  // boolean or `selectionType` enum -- these two integers alone express
  // every V1 rule without redundant fields that could drift out of sync.
  minimumSelections Int                 @map("minimum_selections")
  maximumSelections Int                 @map("maximum_selections")
  displayOrder      Int                 @map("display_order")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  // FT-6B: set only when this Group was created via "Use Preset" -- null
  // for a Group created via "Create Custom" (FT-6A behavior, unchanged).
  // This Group row (and its Options below) remain the ONE runtime
  // authority Public Menu/Cart/PublicOrdersService/OrderItemModifier ever
  // read (Section 3: presets are a Staff-side authoring convenience, never
  // a second pricing/ordering entity). SetNull, not Restrict: an optional
  // soft link -- if the source Preset were ever removed, the linked Group
  // simply detaches and keeps its last-synced values, never blocked.
  sourcePresetId    String?             @map("source_preset_id") @db.Uuid

  // Restrict, not Cascade -- a Modifier Group is a substantive business
  // entity (like Product itself), never a pure translation row. It must
  // never be destructively removed in a way that could break a historical
  // Order's OrderItemModifier snapshot (#58); the only supported removal
  // path is the `status` field.
  restaurant         Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  product            Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourcePreset       ModifierPreset?            @relation(fields: [sourcePresetId], references: [id], onDelete: SetNull)
  translations       ModifierGroupTranslation[]
  options            ModifierOption[]
  orderItemModifiers OrderItemModifier[]

  // Prevents accidentally attaching the SAME Preset twice to the SAME
  // Product (FT-6B, Section 2/4) -- Postgres treats each NULL
  // `sourcePresetId` as distinct, so any number of Custom (non-Preset)
  // Groups on one Product remain unaffected by this constraint.
  @@unique([productId, sourcePresetId])
  @@index([restaurantId])
  @@index([productId])
  @@index([sourcePresetId])
  @@map("modifier_groups")
}

model ModifierGroupTranslation {
  id              String  @id @default(uuid()) @db.Uuid
  modifierGroupId String  @map("modifier_group_id") @db.Uuid
  locale          String
  name            String
  helperText      String? @map("helper_text")

  // Pure translation child of ModifierGroup -- Cascade, same rationale as
  // ProductTranslation/CategoryTranslation.
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([modifierGroupId, locale])
  @@map("modifier_group_translations")
}

model ModifierOption {
  id                   String               @id @default(uuid()) @db.Uuid
  restaurantId         String               @map("restaurant_id") @db.Uuid
  modifierGroupId      String               @map("modifier_group_id") @db.Uuid
  status               ModifierOptionStatus
  // Fixed-precision money (CLAUDE.md #27) -- never Float/Double. May be
  // zero (Ingredient Removal options, MENU_SPEC.md #79) or positive
  // (Extras, #78); no CHECK constraint restricting sign is documented.
  // FT-6B: this remains the ONE authoritative runtime price PublicOrdersService
  // reads (Section 5/9) -- a Preset's own default price is copied HERE at
  // apply-time and re-synced here on Preset change; the client is never the
  // pricing authority.
  priceAdjustment      Decimal              @map("price_adjustment") @db.Decimal(14, 2)
  displayOrder         Int                  @map("display_order")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  // FT-6B: set only when this Option was created via "Use Preset" -- null
  // for a Custom Option (unchanged FT-6A behavior).
  sourcePresetOptionId String?              @map("source_preset_option_id") @db.Uuid
  // True once Staff has explicitly overridden this ONE Product's price away
  // from the linked Preset Option's current default (Section 5) -- while
  // true, a Preset-wide price sync (Section 7) skips this row entirely.
  // No database default (mirrors every other business-meaning column in
  // this schema) -- always explicitly set `false` at creation time by
  // application code, `true` only by the explicit override action.
  priceIsOverridden    Boolean              @map("price_is_overridden")

  // Restrict, same rationale as ModifierGroup -- an Option must survive
  // regardless of later Group/Option lifecycle changes so historical
  // OrderItemModifier rows never lose their reference.
  restaurant         Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  modifierGroup      ModifierGroup               @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  sourcePresetOption ModifierPresetOption?       @relation(fields: [sourcePresetOptionId], references: [id], onDelete: SetNull)
  translations       ModifierOptionTranslation[]
  orderItemModifiers OrderItemModifier[]

  @@index([restaurantId])
  @@index([modifierGroupId])
  @@index([sourcePresetOptionId])
  @@map("modifier_options")
}

model ModifierOptionTranslation {
  id               String @id @default(uuid()) @db.Uuid
  modifierOptionId String @map("modifier_option_id") @db.Uuid
  locale           String
  name             String

  // Pure translation child of ModifierOption -- Cascade, same rationale as
  // ModifierGroupTranslation.
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)

  @@unique([modifierOptionId, locale])
  @@map("modifier_option_translations")
}

// -----------------------------------------------------------------------------
// Modifier Preset (FT-6B): a reusable, Restaurant-scoped Modifier Group
// TEMPLATE (e.g. "Standard Size") that Staff can attach to many Products at
// once instead of hand-building the same Group/Options repeatedly. A Preset
// is authoring convenience ONLY -- it is never read by Public Menu, Cart,
// PublicOrdersService, or OrderItemModifier. Applying a Preset to a Product
// COPIES its current values into real, independent `ModifierGroup`/
// `ModifierOption` rows (linked back via `sourcePresetId`/
// `sourcePresetOptionId` above) -- those Product-local rows remain the one
// runtime authority, unchanged from FT-6A. Same translation-table and
// status-only-deactivation conventions as every other Menu entity.
// -----------------------------------------------------------------------------

enum ModifierPresetStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_preset_status")
}

enum ModifierPresetOptionStatus {
  ACTIVE
  INACTIVE

  @@map("modifier_preset_option_status")
}

model ModifierPreset {
  id                String               @id @default(uuid()) @db.Uuid
  restaurantId      String               @map("restaurant_id") @db.Uuid
  // No database default, mirrors ModifierGroup.status.
  status            ModifierPresetStatus
  minimumSelections Int                  @map("minimum_selections")
  maximumSelections Int                  @map("maximum_selections")
  displayOrder      Int                  @map("display_order")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  translations ModifierPresetTranslation[]
  options      ModifierPresetOption[]
  // Every Product-local ModifierGroup created via "Use Preset" from this
  // Preset -- Section 7's sync propagates this Preset's own field changes
  // to every row in this list.
  linkedGroups ModifierGroup[]

  @@index([restaurantId])
  @@map("modifier_presets")
}

model ModifierPresetTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  modifierPresetId String  @map("modifier_preset_id") @db.Uuid
  locale           String
  name             String
  helperText       String? @map("helper_text")

  modifierPreset ModifierPreset @relation(fields: [modifierPresetId], references: [id], onDelete: Cascade)

  @@unique([modifierPresetId, locale])
  @@map("modifier_preset_translations")
}

model ModifierPresetOption {
  id               String                     @id @default(uuid()) @db.Uuid
  restaurantId     String                     @map("restaurant_id") @db.Uuid
  modifierPresetId String                     @map("modifier_preset_id") @db.Uuid
  status           ModifierPresetOptionStatus
  priceAdjustment  Decimal                    @map("price_adjustment") @db.Decimal(14, 2)
  displayOrder     Int                        @map("display_order")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant     Restaurant                        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  modifierPreset ModifierPreset                    @relation(fields: [modifierPresetId], references: [id], onDelete: Restrict)
  translations   ModifierPresetOptionTranslation[]
  // Every Product-local ModifierOption created from this Preset Option --
  // Section 7's price sync updates every row here EXCEPT ones with
  // `priceIsOverridden = true`.
  linkedOptions  ModifierOption[]

  @@index([restaurantId])
  @@index([modifierPresetId])
  @@map("modifier_preset_options")
}

model ModifierPresetOptionTranslation {
  id                     String @id @default(uuid()) @db.Uuid
  modifierPresetOptionId String @map("modifier_preset_option_id") @db.Uuid
  locale                 String
  name                   String

  modifierPresetOption ModifierPresetOption @relation(fields: [modifierPresetOptionId], references: [id], onDelete: Cascade)

  @@unique([modifierPresetOptionId, locale])
  @@map("modifier_preset_option_translations")
}

// -----------------------------------------------------------------------------
// Table / QR (DATABASE_SPEC.md #34-36, #51-56; QR_SPEC.md #2-3, #11-12,
// #50-51, #55-56, #67, #72, #75)
// -----------------------------------------------------------------------------

model Table {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  tableNumber  String      @map("table_number")
  // No database default (mirrors Restaurant/Branch, DATABASE_SPEC.md
  // #24/#27A): Table creation must explicitly choose the initial status at
  // the application/domain layer. Business Foundation L3 always creates a
  // new Table as ACTIVE.
  status       TableStatus
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  qrCodes    QrCode[]
  orders     Order[]

  // DATABASE_SPEC.md #35: Table Number unique within a Branch. This compound
  // index's leading column (branchId) already serves branchId-only lookups,
  // so no separate @@index([branchId]) is added.
  @@unique([branchId, tableNumber])
  @@index([restaurantId])
  @@map("tables")
}

model QrCode {
  id           String   @id @default(uuid()) @db.Uuid
  publicCode   String   @unique @map("public_code")
  restaurantId String   @map("restaurant_id") @db.Uuid
  // Nullable: required for TABLE (populated from the Table's own branchId,
  // QR_SPEC.md #67), but a future Restaurant-wide GENERIC QR (QR_SPEC.md #4)
  // has no Branch -- enforced by qr_codes_type_context_check, not by
  // NOT NULL here.
  branchId     String?  @map("branch_id") @db.Uuid
  // Nullable: required for TABLE, must be null for GENERIC
  // (QR_SPEC.md #55) -- enforced by qr_codes_type_context_check.
  tableId      String?  @map("table_id") @db.Uuid
  type         QrType
  // No database default, same rationale as Table.status. Business
  // Foundation L3 always creates the initial Table QR as ACTIVE.
  status       QrStatus
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders     Order[]

  // DATABASE_SPEC.md #54/#75: publicCode is globally unique (the @unique
  // above). #56: at most one ACTIVE TABLE QR per Table is enforced by the
  // qr_codes_one_active_table_qr partial unique index, added via committed
  // custom migration SQL -- Prisma's schema syntax cannot express a partial
  // (WHERE-predicated) unique index.
  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@map("qr_codes")
}

// -----------------------------------------------------------------------------
// Order (FT-5, ORDER_LIFECYCLE_SPEC.md #1-51): the minimal V1 slice --
// Dine-In, Table-QR-only ordering. Deliberately does NOT implement Table
// Session, Order Rounds, Kitchen Tickets, Modifiers, or Promotions -- those
// remain later slices layered on top of this same Order/OrderItem shape,
// never a reason to redesign it now. Every Order belongs directly to one
// Table (no session indirection yet).
// -----------------------------------------------------------------------------

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  restaurantId    String      @map("restaurant_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  tableId         String      @map("table_id") @db.Uuid
  qrCodeId        String      @map("qr_code_id") @db.Uuid
  // Guest-generated idempotency key (Section 11/14): one UUID per genuine
  // submission attempt from the browser. `clientRequestId` is client-
  // controlled -- UUID randomness is not itself an authorization/integrity
  // boundary -- so uniqueness is scoped to `qrCodeId`, the authoritative
  // resolved-QR identity, NOT `restaurantId` alone (FT-5 critical fix): two
  // different TABLE QRs in the same Restaurant may legitimately submit the
  // same `clientRequestId` value, and a retry must only ever resolve to the
  // ORIGINAL Order from that SAME QR, never a different Table's Order that
  // happens to share a Restaurant and a client-chosen id.
  clientRequestId String      @map("client_request_id") @db.Uuid
  status          OrderStatus
  // Snapshot of Restaurant.currencyCode at submission time (Section 9) --
  // never re-derived from the current Restaurant row when displaying a
  // historical Order.
  currencyCode    String      @map("currency_code") @db.Char(3)
  // Exact authoritative sum of every OrderItem.lineTotal, computed
  // server-side only (Section 8) -- never trusted from the client, never
  // Float/Double.
  totalAmount     Decimal     @map("total_amount") @db.Decimal(14, 2)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Restrict everywhere (never Cascade): an Order is historical Tenant data,
  // exactly like every other Tenant-owned row in this schema -- its parent
  // Restaurant/Branch/Table/QrCode can never be hard-deleted out from under
  // it.
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table      Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  qrCode     QrCode      @relation(fields: [qrCodeId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@unique([qrCodeId, clientRequestId])
  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  // Section 9/ORDER_LIFECYCLE_SPEC.md #39: the Restaurant default-locale
  // Product name at submission time -- a later Product rename must never
  // rewrite historical Order meaning.
  productNameSnapshot String   @map("product_name_snapshot")
  // Product.basePrice at submission time (Section 8) -- same exact
  // Decimal(14,2) shape as Product itself, never Float/Double.
  unitPrice           Decimal  @map("unit_price") @db.Decimal(14, 2)
  quantity            Int
  // unitPrice * quantity, computed server-side only.
  lineTotal           Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Restrict, mirroring every other Product foreign key in this schema --
  // never Cascade: a historical OrderItem must survive regardless of the
  // referenced Product's own lifecycle.
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/**
 * FT-6A; ORDER_LIFECYCLE_SPEC.md #41 "Modifier Snapshot": one row per
 * selected Modifier Option on one OrderItem, capturing the Group/Option
 * names and the Option's priceAdjustment exactly as they were at submission
 * time. A later rename, price change, or deactivation of the live
 * ModifierGroup/ModifierOption must never alter what a historical Order
 * displays -- mirrors OrderItem's own productNameSnapshot/unitPrice
 * pattern. `displayOrder` preserves the Group-then-Option presentation
 * order from submission time, independent of any later reordering in the
 * live configuration.
 */
model OrderItemModifier {
  id                         String   @id @default(uuid()) @db.Uuid
  orderItemId                String   @map("order_item_id") @db.Uuid
  modifierGroupId            String   @map("modifier_group_id") @db.Uuid
  modifierOptionId           String   @map("modifier_option_id") @db.Uuid
  modifierGroupNameSnapshot  String   @map("modifier_group_name_snapshot")
  modifierOptionNameSnapshot String   @map("modifier_option_name_snapshot")
  priceAdjustmentSnapshot    Decimal  @map("price_adjustment_snapshot") @db.Decimal(14, 2)
  displayOrder               Int      @map("display_order")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Pure structural child of OrderItem -- Cascade, same rationale as
  // ProductTranslation being a pure child of Product.
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  // Restrict, mirroring OrderItem.productId -- the live row must survive so
  // long as any historical snapshot references it.
  modifierGroup  ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierGroupId])
  @@index([modifierOptionId])
  @@map("order_item_modifiers")
}

// -----------------------------------------------------------------------------
// User / Auth (DATABASE_SPEC.md #31, #33A, #33D, #33E; AUTH_TENANCY_SPEC.md
// #15-21, #32, #142, #145)
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  // Normalized login identity used for authentication lookups
  // (DATABASE_SPEC.md #33E, AUTH_TENANCY_SPEC.md #15).
  emailNormalized String    @unique @map("email_normalized")
  passwordHash    String    @map("password_hash")
  status          UserState
  preferredLocale String?   @map("preferred_locale")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  authSessions        AuthSession[]
  passwordResetTokens PasswordResetToken[]
  memberships         RestaurantMembership[]
  sentInvitations     RestaurantInvitation[] @relation("InvitedByUser")

  @@map("users")
}

model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  // Only the hash of the opaque session token is ever stored; the raw token
  // is never persisted (DATABASE_SPEC.md #33A, AUTH_TENANCY_SPEC.md #21).
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // No database default: Auth creation logic explicitly sets the initial
  // lastSeenAt when Auth is implemented.
  lastSeenAt   DateTime  @map("last_seen_at") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // revokedAt has no dedicated index: AUTH_TENANCY_SPEC.md #114 only
  // mentions it as indexed "where useful", and no query pattern currently
  // justifies a speculative index. userId and expiresAt are explicitly
  // required (DATABASE_SPEC.md #130).
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  // Only the hash of the reset token is ever stored (DATABASE_SPEC.md #33D,
  // AUTH_TENANCY_SPEC.md #32).
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Restaurant Membership (DATABASE_SPEC.md #32, #33B; AUTH_TENANCY_SPEC.md
// #37-40, #58-61, #143)
// -----------------------------------------------------------------------------

model RestaurantMembership {
  id           String                     @id @default(uuid()) @db.Uuid
  restaurantId String                     @map("restaurant_id") @db.Uuid
  userId       String                     @map("user_id") @db.Uuid
  role         RestaurantMembershipRole
  status       RestaurantMembershipStatus
  // true = Restaurant-wide Branch access; false = access is restricted to
  // the Branches listed in RestaurantMembershipBranch
  // (AUTH_TENANCY_SPEC.md #58-60). No schema default: every Membership must
  // explicitly decide its Branch scope at creation time.
  allBranches  Boolean                    @map("all_branches")
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  restaurant   Restaurant                   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user         User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  branchAccess RestaurantMembershipBranch[]

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@map("restaurant_memberships")
}

model RestaurantMembershipBranch {
  restaurantMembershipId String @map("restaurant_membership_id") @db.Uuid
  branchId               String @map("branch_id") @db.Uuid

  membership RestaurantMembership @relation(fields: [restaurantMembershipId], references: [id], onDelete: Restrict)
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Cross-Restaurant validation (the Branch must belong to the same
  // Restaurant as the Membership) is a relational invariant that cannot be
  // expressed as a simple column constraint here; it is enforced by
  // application/domain logic (AUTH_TENANCY_SPEC.md #61).
  @@id([restaurantMembershipId, branchId])
  @@index([branchId])
  @@map("restaurant_membership_branches")
}

// -----------------------------------------------------------------------------
// Restaurant Invitation (DATABASE_SPEC.md #33C; AUTH_TENANCY_SPEC.md #76-81,
// #144)
// -----------------------------------------------------------------------------

model RestaurantInvitation {
  id              String                   @id @default(uuid()) @db.Uuid
  restaurantId    String                   @map("restaurant_id") @db.Uuid
  emailNormalized String                   @map("email_normalized")
  role            RestaurantMembershipRole
  allBranches     Boolean                  @map("all_branches")
  // Only the hash of the invitation token is ever stored
  // (DATABASE_SPEC.md #33C).
  tokenHash       String                   @unique @map("token_hash")
  expiresAt       DateTime                 @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?                @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime?                @map("revoked_at") @db.Timestamptz
  invitedByUserId String                   @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  invitedBy  User       @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  // Populated only when allBranches = false (DATABASE_SPEC.md #33C,
  // AUTH_TENANCY_SPEC.md #76). On acceptance, selected Branches are
  // materialized into RestaurantMembershipBranch records for the resulting
  // Restaurant Membership.
  branches RestaurantInvitationBranch[]

  @@index([restaurantId])
  @@index([emailNormalized])
  @@index([expiresAt])
  @@map("restaurant_invitations")
}

// Approved temporary representation for the intended Branch access of a
// Branch-scoped RestaurantInvitation (allBranches = false). Pure join table:
// no independent identity or lifecycle, matching RestaurantMembershipBranch.
// Same-Restaurant validation (each Branch must belong to the same Restaurant
// as the Invitation) and materialization into RestaurantMembershipBranch on
// acceptance are application/domain transaction logic, not schema
// constraints (DATABASE_SPEC.md #33C, AUTH_TENANCY_SPEC.md #61, #76).
model RestaurantInvitationBranch {
  restaurantInvitationId String @map("restaurant_invitation_id") @db.Uuid
  branchId               String @map("branch_id") @db.Uuid

  invitation RestaurantInvitation @relation(fields: [restaurantInvitationId], references: [id], onDelete: Restrict)
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([restaurantInvitationId, branchId])
  @@index([branchId])
  @@map("restaurant_invitation_branches")
}
