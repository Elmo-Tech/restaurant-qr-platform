# =============================================================================
# Restaurant QR Platform -- PRODUCTION environment (application level)
# =============================================================================
#
# DEPLOYING ON COOLIFY: use `infra/docker/coolify.env.example` instead (Coolify supplies the variables and the
# compose file derives the rest). This file documents the application-level variables for any other host.
#
# Copy to `.env` on the server and fill in real values. NEVER commit real
# secrets. This file documents ONLY what the application itself needs; Docker,
# Nginx, TLS certificates and backups are the separate deployment batch.
#
# API runtime values are validated at startup (apps/api/src/config/env.schema.ts):
# a missing/invalid required value fails fast with a clear message. Next.js
# public values are checked when each frontend is built.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=production

# ---- Public addresses -------------------------------------------------------
# The ONE public origin of the Web app (used to build the URL encoded in printed
# QR codes: ${WEB_URL}/q/{publicCode}). Use your final, stable HTTPS domain --
# printed QRs must keep working. No trailing slash.
WEB_URL=https://menu.example.com

# The browser calls the API at this URL. It is baked into a Next.js build at
# `next build` time (NEXT_PUBLIC_*), so set it BEFORE building. Build the
# Restaurant Web app with the menu origin shown below; build Platform Admin
# separately with `https://control.example.com`. Each gateway host routes its
# allowed API paths to NestJS, preserving host-only session cookies.
NEXT_PUBLIC_API_URL=https://menu.example.com
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# Server Components call NestJS on the private container network at runtime.
# This is server-only and is never exposed in browser JavaScript.
API_INTERNAL_URL=http://api:4000

# The single trusted browser origin for credentialed CORS. Must equal the Web
# origin. Never "*".
CORS_ORIGIN=https://menu.example.com

# The second trusted browser origin. Leave unset only when Platform Admin is
# deliberately disabled. Never "*".
PLATFORM_ORIGIN=https://control.example.com

# ---- API server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1

# ---- Database ---------------------------------------------------------------
# Strong, unique credentials. PostgreSQL must be reachable only from the API
# (private network / localhost), never the public internet.
POSTGRES_DB=restaurant_qr_platform
POSTGRES_USER=restaurant_qr_app
POSTGRES_PASSWORD=<generate-a-long-random-password>
DATABASE_URL=postgresql://restaurant_qr_app:<same-password>@localhost:5432/restaurant_qr_platform

# ---- Auth / sessions --------------------------------------------------------
# REQUIRED in production: the API refuses to start with AUTH_COOKIE_SECURE=false.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_COOKIE_NAME=restaurant_session
AUTH_SESSION_TTL_DAYS=30
PLATFORM_SESSION_COOKIE_NAME=platform_session
PLATFORM_SESSION_TTL_HOURS=12
RESTAURANT_INVITATION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=45
SUBSCRIPTION_GRACE_DAYS=7

# ---- Rate limiting ----------------------------------------------------------
# Application-level, in-memory, per API process, keyed by client IP. The reverse
# proxy adds its own limits at deployment (Ops batch).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_PUBLIC_ORDER_LIMIT=30
RATE_LIMIT_PUBLIC_TRACKING_LIMIT=120
RATE_LIMIT_PUBLIC_LOOKUP_LIMIT=10

# Behind Nginx (one proxy hop) this MUST be 1, otherwise every visitor shares the
# proxy's IP and rate limiting either blocks everyone or protects no one.
TRUST_PROXY_HOPS=1

# ---- Uploads (Product / Category images) -------------------------------------
# V1 stores images on local disk. In production this directory MUST be a
# persistent volume that is included in backups -- it does not survive replacing
# a container. Absolute path recommended.
UPLOAD_LOCAL_DIR=/var/lib/restaurant-qr/uploads

# ---- Logging ----------------------------------------------------------------
# One access-log line per request (method, route pattern, status, duration,
# request id) is written to stdout; bodies, cookies and Authorization headers
# are never logged. Forward/rotate container stdout at deployment.
LOG_LEVEL=info

# ---- Optional n8n menu import -----------------------------------------------
# Leave both empty/unset to keep menu import disabled without affecting the
# rest of the platform.
N8N_MENU_IMPORT_URL=
N8N_MENU_IMPORT_SECRET=
MENU_IMPORT_TIMEOUT_SECONDS=300

# ---- NOT needed in the current deployment (leave unset) ---------------------
# AI_*, REALTIME_*, and GUEST_SESSION_* have no runtime consumer in the current
# application.
#
# One-off Operations variable (set in the shell only for the command, then
# remove it -- never store it in this file):
#   PROVISION_OWNER_PASSWORD   see docs/02-technical/OPERATIONS_RUNBOOK.md
