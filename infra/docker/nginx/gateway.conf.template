# Internal gateway behind Coolify's reverse proxy (Traefik or Caddy), which keeps terminating public HTTPS.
# This is NOT a second TLS layer: it listens on plain HTTP inside the private network and only routes by host
# name and path, so each frontend stays same-origin with the API (host-only HttpOnly cookies keep working,
# CORS stays strict, CSRF's Origin check is untouched).
#
#   $RESTAURANT_WILDCARD_HOST  same Guest routes as $WEB_HOST; Platform exact host takes precedence.
#   waytaapp.com    exactly /              -> 302 https://landing.waytaapp.com/ (literal apex host only)
#   $WEB_HOST       /                      -> web       (Next.js, restaurant app)
#                   /api/v1/*, /media/*    -> api       (NestJS)
#                   /socket.io/*           -> api       (Socket.IO / WebSocket transport)
#                   /api/v1/platform/*     -> 404       (the platform routes are not served on the public menu host)
#   $PLATFORM_HOST  /                      -> platform  (Next.js, platform console)
#                   /api/v1/platform/*     -> api       (and nothing else of the API)
#
# $WEB_HOST and $PLATFORM_HOST are filled in from the container environment when it starts (the official
# nginx image runs envsubst over /etc/nginx/templates; only those variables are substituted, see the
# NGINX_ENVSUBST_FILTER in Dockerfile.gateway). Every `$name` below is an nginx variable.

# Containers are replaced on every deployment and get new addresses: names are re-resolved while running instead
# of once at startup (Docker's embedded DNS).
resolver 127.0.0.11 valid=5s ipv6=off;

server_tokens off;
client_max_body_size 16m;       # images are limited to 5 MB and menu imports to 10 MB by the API itself
client_body_timeout 60s;

# The proxy in front of this gateway reports the visitor's protocol; fall back to what this hop saw.
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
# Keep a caller-provided request id (the API accepts 8-64 safe characters), otherwise start one here.
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}
# Upgrade only when asked to (WebSocket-capable, harmless otherwise).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      "";
}
# HSTS only on HTTPS requests.
map $fwd_proto $hsts {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

# The /demo/:token path is a bearer capability. Never log the path segment.
# Match normalized URI (also covers encoded and differently cased variants);
# no request line, raw Referer, query string, cookies or headers in this format.
map $uri $safe_log_uri {
    default $uri;
    ~*^/demo/ /demo/[redacted];
}
log_format gateway '$remote_addr $host "$request_method $safe_log_uri" $status $body_bytes_sent ${request_time}s req=$req_id';
# The official nginx image already has an HTTP-scope "main" access_log that
# includes $request and $http_referer. Each server below declares exactly one
# own access_log to override that inherited directive rather than adding a
# second logger at the HTTP scope.
error_log  /dev/stderr warn;

# Apex homepage -> landing site (see `location = /` in the restaurant app server). Only a query made
# entirely of standard UTM campaign parameters with plain URL-safe values is carried over; anything
# else (unknown keys, tokens, `next=` style values) is dropped as a whole, so nothing private reaches
# the landing origin. `$args` is the raw, still-percent-encoded query string.
map $args $apex_landing_query {
    default "";
    "~^utm_(?:source|medium|campaign|term|content)=[A-Za-z0-9._~%+-]{0,200}(?:&utm_(?:source|medium|campaign|term|content)=[A-Za-z0-9._~%+-]{0,200}){0,4}$" "?$args";
}

# Variables in proxy_pass make nginx resolve the names at request time (see `resolver`).
map $host $web_upstream      { default http://web:3000; }
map $host $platform_upstream { default http://platform:3001; }
map $host $api_upstream      { default http://api:4000; }

# What every proxied request carries upstream.
proxy_http_version 1.1;
proxy_set_header Host               $host;
proxy_set_header X-Real-IP          $remote_addr;
proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Host   $host;
proxy_set_header X-Forwarded-Proto  $fwd_proto;
proxy_set_header X-Request-Id       $req_id;
proxy_set_header Upgrade            $http_upgrade;
proxy_set_header Connection         $connection_upgrade;
proxy_connect_timeout 5s;
proxy_send_timeout    60s;
proxy_read_timeout    60s;
proxy_redirect off;
add_header Strict-Transport-Security $hsts always;
add_header X-Request-Id $req_id always;

# Anything addressed to another host name (a scanner hitting the server IP, a stray domain) gets nothing.
# `/gateway-health` answers for any host so the container health check does not depend on the domains.
server {
    listen 8080 default_server;
    server_name _;

    access_log /dev/stdout gateway;
    # Reject unknown hosts, and suppress upstream/request-line error detail on Demo paths.
    location ~* ^/demo/ {
        error_log /dev/null crit;
        return 444;
    }

    location = /gateway-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 444;
    }
}

# Legacy production domains: keep previously printed QR codes working when Coolify continues
# routing these old HTTPS hosts to this gateway. The new domains remain the only primary origins.
# Preserve existing Evolution API callbacks on the old menu host during the provider migration;
# redirecting webhooks would depend on the provider following 308 for POST requests.
server {
    listen 8080;
    server_name wayta.elmotechsoft.online;

    access_log /dev/stdout gateway;
    location ~* ^/demo/ {
        error_log /dev/null crit;
        return 308 https://waytaapp.com$request_uri;
    }

    location ^~ /api/v1/whatsapp-tracking/webhook/ {
        access_log off;
        proxy_pass $api_upstream;
    }

    location / {
        return 308 https://waytaapp.com$request_uri;
    }
}

server {
    listen 8080;
    server_name wayta-control.elmotechsoft.online;

    access_log /dev/stdout gateway;
    location ~* ^/demo/ {
        error_log /dev/null crit;
        return 308 https://control.waytaapp.com$request_uri;
    }

    location / {
        return 308 https://control.waytaapp.com$request_uri;
    }
}

# ------------------------------------------------------------------------------------------------ restaurant app
server {
    listen 8080;
    server_name ${WEB_HOST} ${RESTAURANT_WILDCARD_HOST};

    access_log /dev/stdout gateway;
    # Nginx logs failed upstream requests with their raw request line unless
    # this capability route has its own restricted error logging.
    location ~* ^/demo/ {
        error_log /dev/null crit;
        proxy_pass $web_upstream;
    }

    # The platform administrators' API lives on the console host only. Nest/Express routing is
    # case-insensitive by default, so this gateway boundary must reject every casing too.
    location ~* ^/api/v1/platform(?:/|$) {
        return 404;
    }

    # Callback carries a high-entropy capability token in the path; do not write
    # it to gateway access logs. API still validates token, instance and order HMAC.
    location ^~ /api/v1/whatsapp-tracking/webhook/ {
        # The legacy host has its own explicit callback block above. Unknown
        # restaurant subdomains must not accept platform-wide webhooks.
        if ($host != ${WEB_HOST}) { return 404; }
        access_log off;
        proxy_pass $api_upstream;
    }

    # Restaurant subdomains can access only QR-scoped public endpoints.
    # The Nest guard additionally checks QR ownership against this Host.
    location ^~ /api/v1/public/qr/ {
        proxy_pass $api_upstream;
    }

    # DEMO capability exchange can receive a token-bearing Referer from older
    # browsers/clients. Keep API routing and the host guard identical while
    # preventing upstream error diagnostics from echoing the raw Referer.
    location = /api/v1/demo/enter {
        if ($host != ${WEB_HOST}) { return 404; }
        error_log /dev/null crit;
        proxy_read_timeout 600s;
        proxy_pass $api_upstream;
    }

    location /api/v1/ {
        # No Staff auth/session/business API on restaurant hostnames.
        if ($host != ${WEB_HOST}) { return 404; }
        # menu imports can wait on the AI workflow for minutes (MENU_IMPORT_TIMEOUT_SECONDS)
        proxy_read_timeout 600s;
        proxy_pass $api_upstream;
    }

    # uploaded product and category images, served by the API from its persistent volume
    location ^~ /media/ {
        proxy_pass $api_upstream;
        # the API sets its own cache and CORS headers; keep them
    }

    # Socket.IO is outside the versioned REST prefix. The shared proxy headers above preserve the
    # Upgrade/Connection handshake, and the longer timeout keeps quiet WebSocket connections alive.
    location ^~ /socket.io/ {
        if ($host != ${WEB_HOST}) { return 404; }
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_pass $api_upstream;
    }

    # The apex homepage moved to the separate landing site. Only the literal production apex host and
    # only the exact path `/` redirect; every other path on the apex (/staff, /login, /q/*, /_next/*,
    # ...) and every restaurant subdomain root (rewritten to its Guest Menu by Next.js) is proxied
    # exactly as before. Hard-coded rather than ${WEB_HOST} so Development/preview hosts never
    # redirect to Production. Temporary (302, no cache headers) while the move is reversible.
    location = / {
        if ($host = waytaapp.com) {
            return 302 https://landing.waytaapp.com/$apex_landing_query;
        }
        proxy_pass $web_upstream;
    }

    location / {
        proxy_pass $web_upstream;
    }
}

# ------------------------------------------------------------------------------------------------ platform console
server {
    listen 8080;
    server_name ${PLATFORM_HOST};

    access_log /dev/stdout gateway;
    location ~* ^/demo/ {
        error_log /dev/null crit;
        proxy_pass $platform_upstream;
    }

    # only the platform routes of the API are reachable from the console host
    location ^~ /api/v1/platform/ {
        # Owner Onboarding A3: only the UUID-scoped menu-import POST needs a larger
        # multipart envelope and a longer, silent AI-extraction response window.
        # Keep the default 16 MiB / 120 s for every other Platform request.
        # A quoted regex is required because UUID quantifiers contain braces.
        location ~ "^/api/v1/platform/onboarding-cases/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/menu-import$" {
            client_max_body_size 42m;  # 40 MiB file data + up to 2 MiB multipart envelope
            proxy_read_timeout 600s;   # inactivity budget; external ingress must be >= 630s
            proxy_pass $api_upstream;
        }

        proxy_read_timeout 120s;
        proxy_pass $api_upstream;
    }

    location ^~ /api/ {
        return 404;
    }

    location ^~ /media/ {
        return 404;
    }

    location / {
        proxy_pass $platform_upstream;
    }
}
