# Internal nginx gateway (host and path routing behind Coolify's HTTPS proxy). See nginx/gateway.conf.template.
# Build context: the repository root.
FROM nginx:1.28-alpine

# The official nginx entrypoint renders this template at startup. Only
# our three environment variables are interpolated; nginx's $host,
# $request_uri, and other native variables are left intact.
ENV NGINX_ENVSUBST_FILTER='^(WEB_HOST|PLATFORM_HOST|RESTAURANT_WILDCARD_HOST)$'
COPY infra/docker/nginx/gateway.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 8080
