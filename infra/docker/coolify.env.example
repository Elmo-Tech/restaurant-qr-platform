# =============================================================================
# Restaurant QR Platform -- Coolify environment variables (compose.coolify.yml)
# =============================================================================
#
# This file is a TEMPLATE. Do not commit real values and do not create a real `.env` in the repository:
# enter these variables in Coolify (Application > Environment Variables). Coolify supplies them to the
# compose file both at build time (the NEXT_PUBLIC_* values are derived from the two hosts) and at run time.
# Full guide: docs/02-technical/COOLIFY_DEPLOYMENT.md
#
# REQUIRED = the deployment stops with a clear message when it is missing.
# Everything else has the default shown and can be left out.

# --- REQUIRED ----------------------------------------------------------------

# The public host names (no scheme, no slash). The restaurant app and its API live on WEB_HOST;
# the platform console and ITS API routes live on PLATFORM_HOST. Choose them once: printed QR codes
# point to https://WEB_HOST/q/<code> and must keep working.
WEB_HOST=menu.example.com
PLATFORM_HOST=control.example.com

# PostgreSQL password. Letters and digits only, so it can sit inside the DATABASE_URL unescaped:
#   openssl rand -hex 24
# Changing it later does NOT change an existing database: change it inside PostgreSQL first.
POSTGRES_PASSWORD=

# --- DATABASE (defaults are fine) ---------------------------------------------
# POSTGRES_DB=restaurant_qr_platform
# POSTGRES_USER=restaurant_qr_app

# --- PROXY --------------------------------------------------------------------
# Reverse proxies in FRONT of the API: Coolify's proxy + the internal gateway = 2.
# Add one for each extra layer you put in front of Coolify (for example Cloudflare = 3).
# Too low and every visitor looks like the proxy (rate limiting hits everyone); too high lets a visitor
# forge their address. See COOLIFY_DEPLOYMENT.md, "TRUST_PROXY_HOPS".
# TRUST_PROXY_HOPS=2

# --- AUTH ---------------------------------------------------------------------
# The cookie names and lifetimes below are the defaults; AUTH_COOKIE_SECURE is forced to "true" and
# SameSite to "lax" by the compose file (production requires them).
# AUTH_SESSION_COOKIE_NAME=restaurant_session
# AUTH_SESSION_TTL_DAYS=30
# PLATFORM_SESSION_COOKIE_NAME=platform_session
# PLATFORM_SESSION_TTL_HOURS=12
# RESTAURANT_INVITATION_TTL_DAYS=7
# PASSWORD_RESET_TTL_MINUTES=45
# SUBSCRIPTION_GRACE_DAYS=7

# --- RATE LIMITING (per client address, per window) -----------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT_LIMIT=300
# RATE_LIMIT_LOGIN_LIMIT=10
# RATE_LIMIT_PUBLIC_ORDER_LIMIT=30
# RATE_LIMIT_PUBLIC_TRACKING_LIMIT=120
# RATE_LIMIT_PUBLIC_LOOKUP_LIMIT=10

# --- LOGGING ------------------------------------------------------------------
# LOG_LEVEL=info
# Accepted values: error, warn, info, debug, verbose.

# --- OPTIONAL: AI menu import through an existing n8n ---------------------------
# Leave both empty to run without it (the import then answers "unavailable"; nothing else is affected).
# Point the URL at your existing n8n webhook (a private address is fine); never put the secret anywhere else.
# N8N_MENU_IMPORT_URL=
# N8N_MENU_IMPORT_SECRET=
# MENU_IMPORT_TIMEOUT_SECONDS=300

# --- OPTIONAL: model API keys managed from the Platform console (DEC-059) ----------
# Encrypts the keys the Platform team saves from the console. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set it ONCE and never change it. Without it the console cannot save keys and the import keeps using n8n.
# AI_KEYS_ENCRYPTION_KEY=

# --- OPTIONAL: temporary demo restaurants (DEC-060) ---------------------------------
# DEMO_MAX_ACTIVE=20
# DEMO_PURGE_GRACE_MINUTES=60
# DEMO_SWEEP_SECONDS=60

# --- OPTIONAL: WhatsApp received-order tracking via Evolution ------------------
# All four are needed to enable *tracked* messages; leave empty to retain
# ordinary wa.me checkout without tracking. Do not prefix these with NEXT_PUBLIC_.
# EVOLUTION_API_URL=https://evolution.example.com
# EVOLUTION_API_KEY=     (secret: Evolution admin API key; not a per-restaurant token)
# WAYTA_API_PUBLIC_URL=https://menu.example.com
# WHATSAPP_ORDER_SIGNING_KEY= (secret: 32 random bytes in Base64, generate once)
# Create signing key on a trusted machine:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The callback's URL contains a capability secret; redact the path from reverse-proxy logs too.

# --- NOT variables --------------------------------------------------------------
# Set by the compose file itself (do not add them): NODE_ENV=production, API_HOST, API_PORT, API_PREFIX,
# DATABASE_URL, CORS_ORIGIN, PLATFORM_ORIGIN, WEB_URL, API_INTERNAL_URL, NEXT_PUBLIC_API_URL,
# NEXT_PUBLIC_API_BASE_PATH, UPLOAD_LOCAL_DIR, AUTH_COOKIE_SECURE, AUTH_COOKIE_SAME_SITE.
